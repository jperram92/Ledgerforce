# LedgerForce self-hosted install settings (T-0094). Copy to infra/compose/ledgerforce.env (git-
# ignored) and edit. No secrets here: passwords are files made by infra/compose/init-secrets.sh.
#
# Public origin of the install. For a trial on this machine keep http://ledgerforce.localhost:8080
# (browsers resolve *.localhost to this machine). In production use your https URL, with TLS
# terminated by a reverse proxy in front of the web service (Docs/ops/install.md).
LF_PUBLIC_URL=http://ledgerforce.localhost:8080
# Port the web service listens on (inside the network too) and the address it is published on.
LF_HTTP_PORT=8080
LF_HTTP_BIND=127.0.0.1

# The organisation and its first Owner. The Owner's sign-in name is this e-mail address.
LF_TENANT_SLUG=harbour-co
LF_TENANT_NAME=Harbour Co
LF_OWNER_EMAIL=owner@example.com
LF_OWNER_NAME=Owner Name

# Set to 1 for one run of setup to issue a new one-time owner password (only while the Owner has
# not completed the first sign-in).
LF_SETUP_REISSUE=0
