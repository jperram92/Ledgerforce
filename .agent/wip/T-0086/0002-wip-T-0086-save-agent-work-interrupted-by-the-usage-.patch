+    const coding = page.getByRole('table', { name: 'Coding' });
+    await expect(coding.getByRole('row').nth(1)).toContainText('6100');
+    await expect(coding.getByRole('row').nth(1)).toContainText('Office expenses');
+    await expect(coding.getByRole('row').nth(1)).toContainText('GST');
