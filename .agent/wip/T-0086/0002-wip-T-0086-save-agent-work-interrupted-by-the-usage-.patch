+    await expect(page.getByRole('region', { name: 'Journal' })).toContainText('posted');
+    await expect(page.getByRole('button', { name: /delete/i })).toHaveCount(0);
+    await assertPage(page, width);
+    await evidence('SS-UC05-08', `bill-posted-journal-${String(width)}`);
+    expect(f.errors).toEqual([]);
+  });
+}
