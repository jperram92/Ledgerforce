+
+test('T-0086: whoever entered a bill above the limit sees Approve disabled, with the rule in words', async ({
+  page,
+}) => {
+  const f = await fakeApi(page, 'both', [waiting]);
+  await open(page, `/purchases/bills/${waiting.id}`, 1440);
+  const approve = page.getByRole('button', { name: 'Approve and post' });
+  await expect(approve).toBeDisabled();
+  const describedBy = await approve.getAttribute('aria-describedby');
+  expect(describedBy).toBeTruthy();
+  const why = (await page.locator(`[id="${describedBy ?? ''}"]`).textContent()) ?? '';
+  expect(why.length).toBeGreaterThanOrEqual(20);
+  expect(why).toContain('1,000.00');
+  await expect(page.getByRole('list', { name: 'People involved' })).toContainText(
+    'Entered by Mei Tan (you)',
+  );
+  await assertPage(page, 1440);
+  expect(f.calls.filter((c) => c.endsWith('/approve'))).toEqual([]);
+  expect(f.errors).toEqual([]);
+});
+
+test('T-0086: an Approver cannot enter bills and sees the queue word', async ({ page }) => {
+  const f = await fakeApi(page, 'approver', [posted, waiting]);
