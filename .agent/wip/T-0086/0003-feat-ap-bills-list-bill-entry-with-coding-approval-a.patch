+import { describe, expect, it } from 'vitest';
+import { billName, billStatus, formToBody, nextTurn, type BillForm } from './bill-logic.ts';
+
+const row = {
+  bill_no: null,
+  status: 'draft' as const,
+  awaiting_approval: false,
+  supplier_name: 'Paper Supplies',
+  supplier_ref: 'INV-7',
+};
+
+describe('bill words (P2, P13)', () => {
+  it('names the state in words, including the approval queue', () => {
+    expect(billStatus(row)).toEqual({ key: 'draft', word: 'Draft' });
+    expect(billStatus({ ...row, awaiting_approval: true })).toEqual({
+      key: 'awaiting',
+      word: 'Waiting for approval',
+    });
+    expect(billStatus({ ...row, status: 'posted' })).toEqual({ key: 'posted', word: 'Posted' });
+    expect(billStatus({ ...row, status: 'void' })).toEqual({ key: 'void', word: 'Void' });
+  });
+  it('names a bill by its number once posted, by supplier invoice before', () => {
+    expect(billName(row)).toBe('Draft bill INV-7 from Paper Supplies');
+    expect(billName({ ...row, status: 'posted', bill_no: 'BILL-000045' })).toBe(
+      'BILL-000045, Paper Supplies',
+    );
+  });
+  it('says who acts next', () => {
+    expect(nextTurn(row)).toBe('AP Clerk: send for approval');
+    expect(nextTurn({ ...row, awaiting_approval: true })).toBe('An Approver');
+    expect(nextTurn({ ...row, status: 'posted' })).toBe('Nobody: posted');
+  });
+});
+
+const good: BillForm = {
+  partyId: 'p1',
+  supplierRef: ' INV-7 ',
+  billDate: '2026-11-03',
+  dueDate: '',
+  lines: [{ description: 'Paper', accountId: 'a1', taxCode: 'GST', amount: '1,250.50' }],
+};
+
+describe('formToBody', () => {
+  it('builds the PUT body with amounts as decimal strings, no due date when blank', () => {
+    expect(formToBody('c1', good)).toEqual({
+      ok: true,
+      body: {
+        company_id: 'c1',
+        party_id: 'p1',
+        supplier_ref: 'INV-7',
+        bill_date: '2026-11-03',
+        lines: [{ description: 'Paper', account_id: 'a1', tax_code: 'GST', amount: '1250.50' }],
+      },
+    });
+  });
+  it('lists every problem in plain words', () => {
+    const r = formToBody('c1', {
+      partyId: '',
+      supplierRef: '',
+      billDate: '',
+      dueDate: '2026-13-40',
+      lines: [
+        { description: '', accountId: '', taxCode: '', amount: '12.345' },
+        { description: 'x', accountId: 'a', taxCode: 'GST', amount: '-5' },
+        { description: 'x', accountId: 'a', taxCode: 'GST', amount: '' },
+      ],
+    });
+    expect(r).toEqual({
+      ok: false,
+      problems: [
+        'Choose the supplier.',
+        "Write the supplier's invoice number.",
+        'Give the bill date.',
+        'The due date is not a real date.',
+        'Line 1: write what it is for.',
+        'Line 1: choose an account.',
+        'Line 1: choose a tax code.',
+        'Line 1: the amount needs at most two decimals.',
+        'Line 2: the amount is a number like 1250.00, without a minus sign or $.',
+        'Line 3: give the amount before GST.',
+      ],
+    });
+  });
+});
diff --git a/apps/web/src/purchases/bill-logic.ts b/apps/web/src/purchases/bill-logic.ts
new file mode 100644
index 0000000..513fb26
--- /dev/null
+++ b/apps/web/src/purchases/bill-logic.ts
@@ -0,0 +1,109 @@
+/**
+ * Plain-word logic of the bills screens (T-0086): the state word (P2), the bill's name, who acts
+ * next (P13) and the entry form's checks. Amounts stay strings: they are only checked against a
+ * pattern and stripped of thousands separators, never converted to a number.
+ */
+import type { BillBody, BillRow } from './client.ts';
+
+type Named = Pick<
+  BillRow,
+  'bill_no' | 'status' | 'awaiting_approval' | 'supplier_name' | 'supplier_ref'
+>;
+
+export function billStatus(b: Pick<BillRow, 'status' | 'awaiting_approval'>): {
+  key: 'draft' | 'awaiting' | 'posted' | 'void';
+  word: string;
+} {
+  if (b.status === 'posted') return { key: 'posted', word: 'Posted' };
+  if (b.status === 'void') return { key: 'void', word: 'Void' };
+  return b.awaiting_approval
+    ? { key: 'awaiting', word: 'Waiting for approval' }
+    : { key: 'draft', word: 'Draft' };
+}
+
+export const billName = (b: Named): string =>
+  b.bill_no
+    ? `${b.bill_no}, ${b.supplier_name}`
+    : `Draft bill ${b.supplier_ref} from ${b.supplier_name}`;
+
+export function nextTurn(b: Pick<BillRow, 'status' | 'awaiting_approval'>): string {
+  if (b.status === 'posted') return 'Nobody: posted';
+  if (b.status === 'void') return 'Nobody: void';
+  return b.awaiting_approval ? 'An Approver' : 'AP Clerk: send for approval';
+}
+
+export interface BillFormLine {
+  description: string;
+  accountId: string;
+  taxCode: string;
+  amount: string;
+}
+
+export interface BillForm {
+  partyId: string;
+  supplierRef: string;
+  billDate: string;
+  dueDate: string;
+  lines: BillFormLine[];
+}
+
+export const emptyLine = (): BillFormLine => ({
+  description: '',
+  accountId: '',
+  taxCode: '',
+  amount: '',
+});
+
+const AMOUNT = /^\d{1,15}(\.\d{1,2})?$/;
+const DATE = /^\d{4}-\d{2}-\d{2}$/;
+const realDate = (d: string) =>
+  DATE.test(d) && new Date(`${d}T00:00:00Z`).toISOString().slice(0, 10) === d;
+const validDate = (d: string) => {
+  try {
+    return realDate(d);
+  } catch {
+    return false;
+  }
+};
+
+export function formToBody(
+  companyId: string,
+  f: BillForm,
+): { ok: true; body: BillBody } | { ok: false; problems: string[] } {
+  const problems: string[] = [];
+  if (!f.partyId) problems.push('Choose the supplier.');
+  if (!f.supplierRef.trim()) problems.push("Write the supplier's invoice number.");
+  if (!f.billDate) problems.push('Give the bill date.');
+  else if (!validDate(f.billDate)) problems.push('The bill date is not a real date.');
+  if (f.dueDate && !validDate(f.dueDate)) problems.push('The due date is not a real date.');
+  const lines = f.lines.map((l, i) => {
+    const n = `Line ${String(i + 1)}`;
+    if (!l.description.trim()) problems.push(`${n}: write what it is for.`);
+    if (!l.accountId) problems.push(`${n}: choose an account.`);
+    if (!l.taxCode) problems.push(`${n}: choose a tax code.`);
+    const amount = l.amount.trim().replace(/,/g, '');
+    if (amount === '') problems.push(`${n}: give the amount before GST.`);
+    else if (/^\d+\.\d{3,}$/.test(amount))
+      problems.push(`${n}: the amount needs at most two decimals.`);
+    else if (!AMOUNT.test(amount))
+      problems.push(`${n}: the amount is a number like 1250.00, without a minus sign or $.`);
+    return {
+      description: l.description.trim(),
+      account_id: l.accountId,
+      tax_code: l.taxCode,
+      amount,
+    };
+  });
+  if (problems.length > 0) return { ok: false, problems };
+  return {
+    ok: true,
+    body: {
+      company_id: companyId,
+      party_id: f.partyId,
+      supplier_ref: f.supplierRef.trim(),
+      bill_date: f.billDate,
+      ...(f.dueDate ? { due_date: f.dueDate } : {}),
+      lines,
+    },
+  };
+}
