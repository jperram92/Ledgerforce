diff --git a/apps/web/src/purchases/BillFormPage.tsx b/apps/web/src/purchases/BillFormPage.tsx
new file mode 100644
index 0000000..070a5af
--- /dev/null
+++ b/apps/web/src/purchases/BillFormPage.tsx
@@ -0,0 +1,307 @@
+/**
+ * Enter a bill (T-0086, UC-05 step 2, SS-UC05-08): the AP Clerk records the supplier's tax invoice
+ * and codes each line to an expense or asset account and a tax code, from the choices the API gives
+ * (GET /ap/bill-coding: createBill's own rules). Saving PUTs the draft under an id chosen once per
+ * form, so a double submit cannot enter it twice. GST and totals are worked out by the API, never
+ * here; the bill page shows them.
+ */
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { Link, useNavigate } from '@tanstack/react-router';
+import { useState, type FormEvent } from 'react';
+import { AdminApiError } from '../admin/client.ts';
+import {
+  Failure,
+  Forbidden,
+  Loading,
+  PageHead,
+  Refusal,
+  useAccess,
+  useFailureRouting,
+} from '../admin/common.tsx';
+import { useServices } from '../env.tsx';
+import { emptyLine, formToBody, type BillForm } from './bill-logic.ts';
+import { useApCompany } from './BillsPage.tsx';
+import type { BillCoding } from './client.ts';
+
+export function BillFormPage() {
+  const access = useAccess();
+  const { purchases } = useServices();
+  const canEnter = access.can('ap.bill.enter');
+  const company = useApCompany();
+  const companyId = company.company?.id ?? '';
+  const coding = useQuery({
+    queryKey: ['ap', 'bill-coding', companyId],
+    queryFn: () => purchases.coding(companyId),
+    enabled: canEnter && !!companyId,
+  });
+  useFailureRouting(coding.error ?? company.error);
+
+  let body;
+  if (access.isPending || (canEnter && (company.isPending || coding.isPending)))
+    body = <Loading what="the bill form" />;
+  else if (access.isError)
+    body = (
+      <Failure
+        heading="We could not check what you may do"
+        error={access.error}
+        onRetry={() => void access.refetch()}
+      />
+    );
+  else if (!canEnter)
+    body = (
+      <Forbidden heading="You can't enter bills">
+        Entering bills is for AP Clerks and Owners. Approvers approve bills someone else entered, so
+        one person never does both.
+      </Forbidden>
+    );
+  else if (company.isError || !companyId)
+    body = (
+      <Failure
+        heading="We could not find your company"
+        error={company.error}
+        onRetry={() => void company.refetch()}
+      />
+    );
+  else if (coding.isError || !coding.data)
+    body = (
+      <Failure
+        heading="We could not load suppliers and accounts"
+        error={coding.error}
+        onRetry={() => void coding.refetch()}
+      />
+    );
+  else body = <Editor companyId={companyId} coding={coding.data} />;
+
+  return (
+    <>
+      <PageHead
+        title="Enter a bill"
+        gloss="Copy the supplier's tax invoice and say what each line was for. Nothing is posted until an Approver approves it."
+      />
+      {body}
+    </>
+  );
+}
+
+function Editor({ companyId, coding }: { companyId: string; coding: BillCoding }) {
+  const { purchases } = useServices();
+  const queryClient = useQueryClient();
+  const navigate = useNavigate();
+  const [billId] = useState(() => crypto.randomUUID());
+  const [form, setForm] = useState<BillForm>(() => ({
+    partyId: '',
+    supplierRef: '',
+    billDate: new Date().toISOString().slice(0, 10),
+    dueDate: '',
+    lines: [emptyLine()],
+  }));
+  const [problems, setProblems] = useState<string[]>([]);
+  const save = useMutation({
+    mutationFn: (b: Parameters<typeof purchases.enter>[1]) => purchases.enter(billId, b),
+    onSuccess: async () => {
+      await queryClient.invalidateQueries({ queryKey: ['ap', 'bills'] });
+      await navigate({ to: '/purchases/bills/$billId', params: { billId } });
+    },
+  });
+  useFailureRouting(save.error);
+  const setLine = (i: number, k: keyof BillForm['lines'][number], v: string) => {
+    setForm({ ...form, lines: form.lines.map((l, j) => (j === i ? { ...l, [k]: v } : l)) });
+  };
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    const b = formToBody(companyId, form);
+    if (!b.ok) {
+      setProblems(b.problems);
+      return;
+    }
+    setProblems([]);
+    save.mutate(b.body);
+  };
+  const refused =
+    save.error instanceof AdminApiError &&
+    save.error.status === 422 &&
+    typeof save.error.body['message'] === 'string'
+      ? save.error.body['message']
+      : null;
+
+  return (
+    <section className="admin-block" aria-labelledby="bill-form-h">
+      <h2 id="bill-form-h" className="sr-only">
+        Bill details
+      </h2>
+      <form className="admin-form gl-form bill-form" onSubmit={submit} noValidate>
+        <label htmlFor="bill-supplier">Supplier</label>
+        <select
+          id="bill-supplier"
+          value={form.partyId}
+          onChange={(e) => {
+            setForm({ ...form, partyId: e.target.value });
+          }}
+        >
+          <option value="">Choose a supplier</option>
+          {coding.suppliers.map((s) => (
+            <option key={s.id} value={s.id}>
+              {s.name}
+            </option>
+          ))}
+        </select>
+        <label htmlFor="bill-ref">Supplier&apos;s invoice number</label>
+        <input
+          id="bill-ref"
+          maxLength={100}
+          autoComplete="off"
+          value={form.supplierRef}
+          onChange={(e) => {
+            setForm({ ...form, supplierRef: e.target.value });
+          }}
+        />
+        <label htmlFor="bill-date">Bill date</label>
+        <input
+          id="bill-date"
+          type="date"
+          value={form.billDate}
+          onChange={(e) => {
+            setForm({ ...form, billDate: e.target.value });
+          }}
+        />
+        <label htmlFor="bill-due">Due date</label>
+        <input
+          id="bill-due"
+          type="date"
+          aria-describedby="bill-due-hint"
+          value={form.dueDate}
+          onChange={(e) => {
+            setForm({ ...form, dueDate: e.target.value });
+          }}
+        />
+        <p id="bill-due-hint" className="admin-note">
+          Leave it empty for 30 days after the bill date.
+        </p>
+        <fieldset className="gl-lines">
+          <legend>What was bought</legend>
+          {form.lines.map((l, i) => {
+            const n = String(i + 1);
+            return (
+              <div className="gl-line" key={i} role="group" aria-label={`Line ${n}`}>
+                <div className="gl-field gl-account">
+                  <label htmlFor={`bill-desc-${n}`}>Line {n} description</label>
+                  <input
+                    id={`bill-desc-${n}`}
+                    maxLength={500}
+                    value={l.description}
+                    onChange={(e) => {
+                      setLine(i, 'description', e.target.value);
+                    }}
+                  />
+                </div>
+                <div className="gl-field gl-memo">
+                  <label htmlFor={`bill-acct-${n}`}>Line {n} account</label>
+                  <select
+                    id={`bill-acct-${n}`}
+                    value={l.accountId}
+                    onChange={(e) => {
+                      setLine(i, 'accountId', e.target.value);
+                    }}
+                  >
+                    <option value="">Choose an account</option>
+                    <optgroup label="Expenses: used up now">
+                      {coding.accounts
+                        .filter((a) => a.type === 'expense')
+                        .map((a) => (
+                          <option key={a.id} value={a.id}>
+                            {`${a.code} ${a.name}`}
+                          </option>
+                        ))}
+                    </optgroup>
+                    <optgroup label="Assets: kept and used over time">
+                      {coding.accounts
+                        .filter((a) => a.type === 'asset')
+                        .map((a) => (
+                          <option key={a.id} value={a.id}>
+                            {`${a.code} ${a.name}`}
+                          </option>
+                        ))}
+                    </optgroup>
+                  </select>
+                </div>
+                <div className="gl-field">
+                  <label htmlFor={`bill-tax-${n}`}>Line {n} tax code</label>
+                  <select
+                    id={`bill-tax-${n}`}
+                    value={l.taxCode}
+                    onChange={(e) => {
+                      setLine(i, 'taxCode', e.target.value);
+                    }}
+                  >
+                    <option value="">Choose</option>
+                    {coding.tax_codes.map((t) => (
+                      <option key={t.code} value={t.code}>
+                        {`${t.code}: ${t.name}`}
+                      </option>
+                    ))}
+                  </select>
+                </div>
+                <div className="gl-field">
+                  <label htmlFor={`bill-amt-${n}`}>Line {n} amount before GST</label>
+                  <input
+                    id={`bill-amt-${n}`}
+                    inputMode="decimal"
+                    autoComplete="off"
+                    className="num"
+                    value={l.amount}
+                    onChange={(e) => {
+                      setLine(i, 'amount', e.target.value);
+                    }}
+                  />
+                </div>
+                {form.lines.length > 1 ? (
+                  <button
+                    type="button"
+                    className="secondary"
+                    onClick={() => {
+                      setForm({ ...form, lines: form.lines.filter((_, j) => j !== i) });
+                    }}
+                  >
+                    Remove line {n}
+                  </button>
+                ) : null}
+              </div>
+            );
+          })}
+          <button
+            type="button"
+            className="secondary"
+            onClick={() => {
+              setForm({ ...form, lines: [...form.lines, emptyLine()] });
+            }}
+          >
+            Add a line
+          </button>
+        </fieldset>
+        {problems.length > 0 ? (
+          <div className="refusal" role="alert">
+            <p>Before saving:</p>
+            <ul>
+              {problems.map((p) => (
+                <li key={p}>{p}</li>
+              ))}
+            </ul>
+          </div>
+        ) : null}
+        <button type="submit" className="primary" disabled={save.isPending}>
+          Save draft bill
+        </button>
+      </form>
+      {refused ? (
+        <p className="refusal" role="alert">
+          LedgerForce did not accept this bill: {refused}
+        </p>
+      ) : (
+        <Refusal error={save.error} />
+      )}
+      <p className="admin-note">
+        <Link to="/purchases/bills">Back to bills without saving</Link>
+      </p>
+    </section>
+  );
+}
diff --git a/apps/web/src/purchases/BillPage.tsx b/apps/web/src/purchases/BillPage.tsx
new file mode 100644
index 0000000..b7642cd
--- /dev/null
+++ b/apps/web/src/purchases/BillPage.tsx
@@ -0,0 +1,344 @@
+/**
+ * One bill (T-0086, UC-05, SS-UC05-08): the coding as entered with the API's GST and totals, the
+ * people involved (P7), the next step — "Send for approval" for the AP Clerk, "Approve and post"
+ * for an Approver — with the separation-of-duties rule in words before anyone tries it (P6), and
+ * the journal: on request the posting engine's preview while it is a draft (P4), and the posted
+ * entry once approved (P5: nothing here deletes or edits a posted bill). Whether the caller may
+ * approve is decided by the API (SoD outlook), and the approve route checks it again.
+ */
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { Link } from '@tanstack/react-router';
+import { formatMoney, JournalTable, Money } from '@ledgerforce/ui';
+import { useId, useState, type ReactNode } from 'react';
+import { AdminApiError } from '../admin/client.ts';
+import {
+  Failure,
+  Loading,
+  PageHead,
+  Refusal,
+  useAccess,
+  useFailureRouting,
+} from '../admin/common.tsx';
+import { useServices } from '../env.tsx';
+import { typeGloss } from '../gl/gl-logic.ts';
+import { billStatus } from './bill-logic.ts';
+import { ApForbidden, useApCompany } from './BillsPage.tsx';
+import type { Bill, BillStep } from './client.ts';
+
+function Region({ heading, children }: { heading: string; children: ReactNode }) {
+  const id = useId();
+  return (
+    <section className="admin-block" aria-labelledby={id}>
+      <h2 id={id}>{heading}</h2>
+      {children}
+    </section>
+  );
+}
+
+const when = (iso: string) =>
+  new Date(iso).toLocaleString('en-AU', {
+    day: 'numeric',
+    month: 'short',
+    hour: 'numeric',
+    minute: '2-digit',
+  });
+const who = (s: BillStep) => `${s.by}${s.you ? ' (you)' : ''}, ${when(s.at)}`;
+
+const refusalText = (e: unknown): string | null =>
+  e instanceof AdminApiError && e.status === 422 && typeof e.body['message'] === 'string'
+    ? e.body['message']
+    : null;
+
+export function BillPage({ billId }: { billId: string }) {
+  const access = useAccess();
+  const { purchases } = useServices();
+  const canRead = access.can('ap.read');
+  const company = useApCompany();
+  const companyId = company.company?.id ?? '';
+  const doc = useQuery({
+    queryKey: ['ap', 'bill', billId],
+    queryFn: () => purchases.bill(companyId, billId),
+    enabled: canRead && !!companyId,
+  });
+  useFailureRouting(doc.error ?? company.error);
+
+  if (access.isPending || (canRead && (company.isPending || doc.isPending)))
+    return <Loading what="the bill" />;
+  if (access.isError)
+    return (
+      <Failure
+        heading="We could not check what you may do"
+        error={access.error}
+        onRetry={() => void access.refetch()}
+      />
+    );
+  if (!canRead) return <ApForbidden />;
+  if (doc.isError || !doc.data)
+    return (
+      <Failure
+        heading="We could not load this bill"
+        error={doc.error}
+        onRetry={() => void doc.refetch()}
+      />
+    );
+  return <BillView bill={doc.data} companyId={companyId} can={access.can} />;
+}
+
+function BillView({
+  bill,
+  companyId,
+  can,
+}: {
+  bill: Bill;
+  companyId: string;
+  can: (p: string) => boolean;
+}) {
+  const st = billStatus(bill);
+  const title = bill.bill_no ? `Bill ${bill.bill_no}` : `Draft bill from ${bill.supplier_name}`;
+  return (
+    <>
+      <PageHead
+        title={title}
+        gloss={`${bill.supplier_name}'s invoice ${bill.supplier_ref}, dated ${bill.bill_date}, due ${bill.due_date}. Amounts in ${bill.currency}.`}
+      />
+      <p className="admin-note">
+        <span className="word" data-status={st.key}>
+          {st.word}
+        </span>
+      </p>
+
+      <Region heading="Coding">
+        <table className="admin-table" aria-label="Coding">
+          <thead>
+            <tr>
+              <th scope="col">Description</th>
+              <th scope="col">Account</th>
+              <th scope="col">Tax code</th>
+              <th scope="col" className="num">
+                Before GST
+              </th>
+            </tr>
+          </thead>
+          <tbody>
+            {bill.lines.map((l) => (
+              <tr key={l.line_no}>
+                <td data-label="Description">{l.description}</td>
+                <td data-label="Account">
+                  {l.account_code} {l.account_name}
+                </td>
+                <td data-label="Tax code">{l.tax_code}</td>
+                <td data-label="Before GST" className="num">
+                  <Money value={l.amount} />
+                </td>
+              </tr>
+            ))}
+          </tbody>
+          <tfoot className="bill-totals">
+            {(
+              [
+                ['Before GST', 'Before GST', bill.net],
+                ['GST you can claim back', 'GST', bill.tax],
+                [`Total you owe ${bill.supplier_name}`, 'Total', bill.gross],
+              ] as const
+            ).map(([label, short, value]) => (
+              <tr key={short}>
+                <td colSpan={3} className="bill-total-label">
+                  {label}
+                </td>
+                <td data-label={short} className="num">
+                  <Money value={value} />
+                </td>
+              </tr>
+            ))}
+          </tfoot>
+        </table>
+      </Region>
+
+      <Approval bill={bill} companyId={companyId} can={can} />
+      <Journal bill={bill} companyId={companyId} />
+      <p className="admin-note">
+        <Link to="/purchases/bills">All bills</Link>
+      </p>
+    </>
+  );
+}
+
+function Approval({
+  bill,
+  companyId,
+  can,
+}: {
+  bill: Bill;
+  companyId: string;
+  can: (p: string) => boolean;
+}) {
+  const { purchases, api } = useServices();
+  const queryClient = useQueryClient();
+  const me = useQuery({ queryKey: ['auth', 'me'], queryFn: () => api.me() });
+  const whyId = useId();
+  const act = useMutation({
+    mutationFn: (what: 'submit' | 'approve') =>
+      what === 'submit'
+        ? purchases.submit(companyId, bill.id)
+        : purchases.approve(companyId, bill.id),
+    onSuccess: async () => {
+      await queryClient.invalidateQueries({ queryKey: ['ap', 'bill', bill.id] });
+      await queryClient.invalidateQueries({ queryKey: ['ap', 'bills'] });
+    },
+  });
+  useFailureRouting(act.error);
+  const open = bill.status === 'draft';
+  const canApprove = can('ap.bill.approve');
+  const limit = bill.approval.self_approval_threshold
+    ? formatMoney(bill.approval.self_approval_threshold, { currency: bill.currency }).text
+    : null;
+  const rule = limit
+    ? `Bills over ${limit} need someone other than the person who entered them to approve them.`
+    : null;
+  const refused = refusalText(act.error);
+
+  let action: ReactNode = null;
+  if (open && !bill.awaiting_approval) {
+    action = can('ap.bill.enter') ? (
+      <button
+        type="button"
+        className="primary"
+        disabled={act.isPending}
+        onClick={() => {
+          act.mutate('submit');
+        }}
+      >
+        Send for approval
+      </button>
+    ) : (
+      <p className="admin-note">
+        The AP Clerk who entered it sends it for approval when it is coded.
+      </p>
+    );
+  } else if (open && canApprove) {
+    const blocked = !bill.approval.allowed;
+    action = (
+      <div className="gl-actions-col">
+        {blocked ? (
+          <p id={whyId} className="admin-note">
+            {bill.approval.rule === 'SOD_BILL_SELF_APPROVAL'
+              ? `You entered this bill. ${rule ?? ''} Another Approver has to approve it.`
+              : 'A separation-of-duties rule stops you approving this bill. Another Approver has to approve it.'}
+            {bill.approval.small_team_exception_required
+              ? ' In small-team mode the Owner can allow it as a recorded exception.'
+              : ''}
+          </p>
+        ) : null}
+        <div className="gl-actions">
+          <button
+            type="button"
+            className="primary"
+            disabled={blocked || act.isPending}
+            {...(blocked ? { 'aria-describedby': whyId } : {})}
+            onClick={() => {
+              act.mutate('approve');
+            }}
+          >
+            Approve and post
+          </button>
+        </div>
+      </div>
+    );
+  } else if (open) {
+    action = <p className="admin-note">Waiting for an Approver. You can&apos;t approve bills.</p>;
+  }
+
+  return (
+    <Region heading="Approval">
+      <ul className="gl-people" aria-label="People involved">
+        {bill.entered ? <li>Entered by {who(bill.entered)}</li> : null}
+        {bill.submitted ? <li>Sent for approval by {who(bill.submitted)}</li> : null}
+        {open && bill.awaiting_approval ? (
+          canApprove && bill.approval.allowed ? (
+            <li>Approver: {me.data?.display_name ?? 'you'} (you)</li>
+          ) : (
+            <li>Approver: anyone with the Approver role who did not enter it</li>
+          )
+        ) : null}
+        {bill.approved ? <li>Approved by {who(bill.approved)}</li> : null}
+      </ul>
+      {open && rule ? <p className="admin-note">{rule}</p> : null}
+      {action}
+      {refused ? (
+        <p className="refusal" role="alert">
+          LedgerForce did not accept this: {refused}
+        </p>
+      ) : (
+        <Refusal error={act.error} />
+      )}
+    </Region>
+  );
+}
+
+function Journal({ bill, companyId }: { bill: Bill; companyId: string }) {
+  const { purchases } = useServices();
+  const posted = bill.status !== 'draft';
+  const [want, setWant] = useState(false);
+  const journal = useQuery({
+    queryKey: ['ap', 'bill', bill.id, 'journal', bill.status],
+    queryFn: () => purchases.journal(companyId, bill.id),
+    enabled: posted || want,
+    retry: false,
+  });
+  const refused = refusalText(journal.error);
+
+  let body: ReactNode;
+  if (!posted && !want)
+    body = (
+      <button
+        type="button"
+        className="secondary"
+        onClick={() => {
+          setWant(true);
+        }}
+      >
+        Show me the journal
+      </button>
+    );
+  else if (journal.isPending)
+    body = <Loading what={posted ? 'the posted journal' : 'the journal LedgerForce would post'} />;
+  else if (journal.isSuccess) {
+    const j = journal.data;
+    body = (
+      <>
+        <p className="admin-note">
+          {j.posted
+            ? `This bill is posted as journal ${j.entry_no ?? ''} on ${j.entry_date}. Posted journals are never edited or deleted; a correction is a reversal.`
+            : 'This is the journal LedgerForce would post when the bill is approved, from the posting engine itself. Nothing is posted yet.'}
+          {!j.posted && j.redirected
+            ? ` The date ${j.requested_date} is in a closed period, so it would post on ${j.entry_date}.`
+            : ''}
+        </p>
+        <JournalTable
+          journal={j.posted ? (j.entry_no ?? 'posted') : 'preview'}
+          currency={j.base_currency}
+          lines={j.lines.map((l) => ({
+            code: l.account_code,
+            account: l.account_name,
+            gloss: typeGloss(l.account_type),
+            ...(l.debit !== '0.0000' ? { debit: l.debit } : { credit: l.credit }),
+          }))}
+        />
+      </>
+    );
+  } else if (refused)
+    body = (
+      <p className="refusal" role="alert">
+        We could not build the journal: {refused}
+      </p>
+    );
+  else
+    body = (
+      <Failure
+        heading="We could not load the journal"
+        error={journal.error}
+        onRetry={() => void journal.refetch()}
+      />
+    );
+  return <Region heading="Journal">{body}</Region>;
+}
