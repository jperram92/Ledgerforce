diff --git a/apps/web/src/reports/AgedPage.tsx b/apps/web/src/reports/AgedPage.tsx
new file mode 100644
index 0000000..10ca96f
--- /dev/null
+++ b/apps/web/src/reports/AgedPage.tsx
@@ -0,0 +1,182 @@
+/**
+ * Aged receivables and aged payables (T-0089, design §8.1, SS-RPT-05/06): what each customer owes
+ * you, or you owe each supplier, at a date, by how long it is past due — rows and totals as the
+ * API returned them. Each name opens that party's general-ledger lines to the date (P1).
+ */
+import { useQuery } from '@tanstack/react-query';
+import { Link, useNavigate } from '@tanstack/react-router';
+import { Money } from '@ledgerforce/ui';
+import { Empty, PageHead } from '../admin/common.tsx';
+import { useServices } from '../env.tsx';
+import { AGE_BUCKETS, type Aged, type AgeBucket } from './client.ts';
+import { queryState, ReportFilters, ReportScope, useReportGate } from './common.tsx';
+import { csvAmount, csvText, dayWords, localToday, toCsv } from './logic.ts';
+
+const BUCKET_WORDS: Record<AgeBucket, string> = {
+  current: 'Not yet due',
+  days1to30: '1–30 days late',
+  days31to60: '31–60 days late',
+  days61to90: '61–90 days late',
+  days90plus: 'Over 90 days late',
+};
+
+interface Kind {
+  title: string;
+  gloss: string;
+  path: '/reports/aged-receivables' | '/reports/aged-payables';
+  permission: string;
+  what: string;
+  party: string;
+  file: string;
+  empty: string;
+}
+
+const KINDS = {
+  receivables: {
+    title: 'Aged receivables',
+    gloss:
+      'What each customer owes you on a date, by how late it is (accounts receivable ageing). Credits you hold for a customer reduce what they owe.',
+    path: '/reports/aged-receivables',
+    permission: 'ar.read',
+    what: 'aged receivables',
+    party: 'Customer',
+    file: 'aged-receivables',
+    empty: 'No customer owes you anything on this date.',
+  },
+  payables: {
+    title: 'Aged payables',
+    gloss:
+      'What you owe each supplier on a date, by how late it is (accounts payable ageing). Payments made ahead reduce what you owe.',
+    path: '/reports/aged-payables',
+    permission: 'ap.read',
+    what: 'aged payables',
+    party: 'Supplier',
+    file: 'aged-payables',
+    empty: 'You owe no supplier anything on this date.',
+  },
+} as const satisfies Record<string, Kind>;
+
+export function agedCsv(kind: Kind, aged: Aged): string {
+  return toCsv([
+    [kind.party, ...AGE_BUCKETS.map((b) => BUCKET_WORDS[b]), 'Total'],
+    ...aged.rows.map((r) => [
+      csvText(r.partyName),
+      ...AGE_BUCKETS.map((b) => csvAmount(r[b])),
+      csvAmount(r.total),
+    ]),
+    ['Total', ...AGE_BUCKETS.map((b) => csvAmount(aged.totals[b])), csvAmount(aged.totals.total)],
+  ]);
+}
+
+export function AgedPage({
+  kind: which,
+  search,
+}: {
+  kind: keyof typeof KINDS;
+  search: { as_of?: string };
+}) {
+  const kind: Kind = KINDS[which];
+  const { reports } = useServices();
+  const navigate = useNavigate();
+  const asOf = search.as_of ?? localToday();
+  const gate = useReportGate(kind.permission, kind.what);
+  const co = gate.company;
+  const q = useQuery({
+    queryKey: ['reports', kind.file, co?.id ?? '', asOf],
+    queryFn: () =>
+      which === 'receivables'
+        ? reports.agedReceivables(co?.id ?? '', asOf)
+        : reports.agedPayables(co?.id ?? '', asOf),
+    enabled: !!co,
+  });
+  const aged = q.data;
+
+  let body = gate.blocked;
+  if (!body) {
+    const state = queryState(q, kind.what);
+    body = (
+      <>
+        <ReportFilters
+          key={asOf}
+          fields={[{ name: 'as_of', label: 'As at', value: asOf }]}
+          onShow={(v) => void navigate({ to: kind.path, search: { as_of: v['as_of'] ?? asOf } })}
+          csv={
+            aged && aged.rows.length > 0
+              ? { fileName: `${kind.file}-${asOf}.csv`, content: () => agedCsv(kind, aged) }
+              : undefined
+          }
+        />
+        {state ??
+          (aged && aged.rows.length === 0 ? (
+            <Empty heading="Nothing outstanding">{kind.empty}</Empty>
+          ) : aged ? (
+            <div className="admin-block">
+              <ReportScope>
+                {co?.name}, as at {dayWords(aged.asOf)}. Amounts in {co?.base_currency}; credits in
+                brackets.
+              </ReportScope>
+              <table className="admin-table report-aged" aria-label={kind.title}>
+                <thead>
+                  <tr>
+                    <th scope="col">{kind.party}</th>
+                    {AGE_BUCKETS.map((b) => (
+                      <th scope="col" className="num" key={b}>
+                        {BUCKET_WORDS[b]}
+                      </th>
+                    ))}
+                    <th scope="col" className="num">
+                      Total
+                    </th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {aged.rows.map((r) => (
+                    <tr key={r.partyId}>
+                      <th scope="row" data-label={kind.party}>
+                        <Link
+                          to="/reports/gl-detail"
+                          search={{ to: aged.asOf, party_id: r.partyId }}
+                        >
+                          {r.partyName}
+                        </Link>
+                      </th>
+                      {AGE_BUCKETS.map((b) => (
+                        <td data-label={BUCKET_WORDS[b]} className="num" key={b}>
+                          <Money value={r[b]} />
+                        </td>
+                      ))}
+                      <td data-label="Total" className="num">
+                        <Money value={r.total} />
+                      </td>
+                    </tr>
+                  ))}
+                </tbody>
+                <tfoot>
+                  <tr>
+                    <th scope="row" data-label={kind.party}>
+                      Total
+                    </th>
+                    {AGE_BUCKETS.map((b) => (
+                      <td data-label={BUCKET_WORDS[b]} className="num" key={b}>
+                        <Money value={aged.totals[b]} />
+                      </td>
+                    ))}
+                    <td data-label="Total" className="num">
+                      <Money value={aged.totals.total} />
+                    </td>
+                  </tr>
+                </tfoot>
+              </table>
+            </div>
+          ) : null)}
+      </>
+    );
+  }
+
+  return (
+    <>
+      <PageHead title={kind.title} gloss={kind.gloss} />
+      {body}
+    </>
+  );
+}
diff --git a/apps/web/src/reports/BalanceSheetPage.tsx b/apps/web/src/reports/BalanceSheetPage.tsx
new file mode 100644
index 0000000..c1607c1
--- /dev/null
+++ b/apps/web/src/reports/BalanceSheetPage.tsx
@@ -0,0 +1,149 @@
+/**
+ * Balance sheet (T-0089, design §8.1, §3.5, SS-RPT-03): assets, liabilities and equity at a date,
+ * with the retained and current-year earnings lines the report works out, and the "balanced" flag
+ * — all as the API returned them. Posted lines open their general-ledger detail for the financial
+ * year to the date; current-year earnings opens the profit and loss for the same dates (P1).
+ */
+import { useQuery } from '@tanstack/react-query';
+import { Link, useNavigate } from '@tanstack/react-router';
+import { Money } from '@ledgerforce/ui';
+import { PageHead } from '../admin/common.tsx';
+import { useServices } from '../env.tsx';
+import type { BalanceSheet, StatementLine } from './client.ts';
+import { queryState, ReportFilters, ReportScope, useReportGate } from './common.tsx';
+import { csvAmount, dayWords, localToday, toCsv } from './logic.ts';
+import {
+  STATEMENT_CSV_HEADER,
+  statementCsvRows,
+  StatementTable,
+  type SectionSpec,
+} from './Statement.tsx';
+
+const sectionsOf = (bs: BalanceSheet): SectionSpec[] => [
+  { heading: 'Assets', totalLabel: 'Total assets', section: bs.assets },
+  { heading: 'Liabilities', totalLabel: 'Total liabilities', section: bs.liabilities },
+  { heading: 'Equity', totalLabel: 'Total equity', section: bs.equity },
+];
+
+export function balanceSheetCsv(bs: BalanceSheet): string {
+  return toCsv([
+    STATEMENT_CSV_HEADER,
+    ...statementCsvRows(sectionsOf(bs)),
+    ['', '', '', 'Total liabilities and equity', csvAmount(bs.total_liabilities_and_equity)],
+  ]);
+}
+
+function LineLink({
+  bs,
+  line,
+  subtype,
+}: {
+  bs: BalanceSheet;
+  line: StatementLine;
+  subtype: string;
+}) {
+  const name = (
+    <>
+      <span className="code">{line.code}</span> {line.name}
+    </>
+  );
+  if (!line.computed)
+    return (
+      <Link
+        to="/reports/gl-detail"
+        search={{ from: bs.fiscal_year.start, to: bs.as_at, account_id: line.account_id }}
+      >
+        {name}
+      </Link>
+    );
+  // Current-year earnings is this year's profit: the P&L from the year start shows where it
+  // comes from. Retained earnings spans every earlier year, so it is described, not linked.
+  return subtype === 'current_year_earnings' ? (
+    <Link to="/reports/profit-and-loss" search={{ from: bs.fiscal_year.start, to: bs.as_at }}>
+      {name}
+    </Link>
+  ) : (
+    <span>{name}</span>
+  );
+}
+
+export function BalanceSheetPage({ search }: { search: { as_at?: string } }) {
+  const { reports } = useServices();
+  const navigate = useNavigate();
+  const asAt = search.as_at ?? localToday();
+  const gate = useReportGate('reports.run', 'the balance sheet');
+  const co = gate.company;
+  const q = useQuery({
+    queryKey: ['reports', 'bs', co?.id ?? '', asAt],
+    queryFn: () => reports.balanceSheet(co?.id ?? '', asAt),
+    enabled: !!co,
+  });
+  const bs = q.data;
+
+  let body = gate.blocked;
+  if (!body) {
+    const state = queryState(q, 'the balance sheet');
+    body = (
+      <>
+        <ReportFilters
+          key={asAt}
+          fields={[{ name: 'as_at', label: 'As at', value: asAt }]}
+          onShow={(v) =>
+            void navigate({ to: '/reports/balance-sheet', search: { as_at: v['as_at'] ?? asAt } })
+          }
+          csv={
+            bs
+              ? { fileName: `balance-sheet-${asAt}.csv`, content: () => balanceSheetCsv(bs) }
+              : undefined
+          }
+        />
+        {state ??
+          (bs ? (
+            <div className="admin-block">
+              <ReportScope>
+                {co?.name}, as at {dayWords(bs.as_at)}, in financial year {bs.fiscal_year.label} (
+                {dayWords(bs.fiscal_year.start)} to {dayWords(bs.fiscal_year.end)}). Amounts in{' '}
+                {bs.currency}.
+              </ReportScope>
+              <StatementTable
+                label="Balance sheet"
+                currency={bs.currency}
+                sections={sectionsOf(bs)}
+                lineLink={(l, subtype) => <LineLink bs={bs} line={l} subtype={subtype} />}
+                footer={
+                  <tr>
+                    <th scope="row">Total liabilities and equity</th>
+                    <td className="num">
+                      <Money value={bs.total_liabilities_and_equity} />
+                    </td>
+                  </tr>
+                }
+              />
+              <p className="report-check">
+                <span className="word" data-status={bs.balanced ? 'balanced' : 'unbalanced'}>
+                  {bs.balanced
+                    ? 'Balanced: assets equal liabilities plus equity'
+                    : 'Not balanced: assets differ from liabilities plus equity'}
+                </span>
+              </p>
+              <p className="admin-note">
+                Lines marked &ldquo;Worked out&rdquo; are not posted: retained earnings adds the
+                profit of earlier years, and current year earnings is this year&rsquo;s profit to
+                date.
+              </p>
+            </div>
+          ) : null)}
+      </>
+    );
+  }
+
+  return (
+    <>
+      <PageHead
+        title="Balance sheet"
+        gloss="What the business owns, owes and is worth on one day, from posted journals."
+      />
+      {body}
+    </>
+  );
+}
diff --git a/apps/web/src/reports/GlDetailPage.tsx b/apps/web/src/reports/GlDetailPage.tsx
new file mode 100644
index 0000000..ad0f8f2
--- /dev/null
+++ b/apps/web/src/reports/GlDetailPage.tsx
@@ -0,0 +1,271 @@
+/**
+ * General-ledger detail (T-0089, design §8.1, SS-RPT-04): for each account, the opening balance,
+ * every posted line in date order with the running balance, and the closing balance — all as the
+ * API (GET /gl/detail) returned them. Filters: dates, one account, and a customer or supplier
+ * (from the aged reports). Balances read debit-positive; credit balances are in brackets.
+ */
+import { useQuery } from '@tanstack/react-query';
+import { Link, useNavigate } from '@tanstack/react-router';
+import { useId, useState } from 'react';
+import { Money } from '@ledgerforce/ui';
+import { Empty, PageHead, useAccess } from '../admin/common.tsx';
+import { useServices } from '../env.tsx';
+import type { GlDetail } from './client.ts';
+import { queryState, ReportFilters, ReportScope, useReportGate } from './common.tsx';
+import {
+  csvAmount,
+  csvText,
+  dateRange,
+  dayWords,
+  localToday,
+  toCsv,
+  type GlDetailSearch,
+} from './logic.ts';
+
+export function glDetailCsv(gl: GlDetail): string {
+  const rows: string[][] = [
+    ['Code', 'Account', 'Date', 'Entry', 'Details', 'Debit', 'Credit', 'Balance'],
+  ];
+  for (const a of gl.accounts) {
+    const acct = [csvText(a.code), csvText(a.name)];
+    rows.push([...acct, '', '', 'Opening balance', '', '', csvAmount(a.opening)]);
+    for (const l of a.lines)
+      rows.push([
+        ...acct,
+        l.date,
+        csvText(l.entry_no ?? ''),
+        csvText(details(l.memo, l.party_name)),
+        csvAmount(l.debit),
+        csvAmount(l.credit),
+        csvAmount(l.balance),
+      ]);
+    rows.push([
+      ...acct,
+      '',
+      '',
+      'Closing balance',
+      csvAmount(a.total_debit),
+      csvAmount(a.total_credit),
+      csvAmount(a.closing),
+    ]);
+  }
+  return toCsv(rows);
+}
+
+const details = (memo: string | null, party: string | null) =>
+  [memo, party].filter((s): s is string => !!s).join(', ');
+
+function AccountPicker({ value }: { value: string }) {
+  const id = useId();
+  const [chosen, setChosen] = useState(value);
+  const { gl } = useServices();
+  const access = useAccess();
+  const canRead = access.can('gl.account.read');
+  const chart = useQuery({
+    queryKey: ['gl', 'chart'],
+    queryFn: () => gl.chart(),
+    enabled: canRead,
+  });
+  const accounts = [...(chart.data?.accounts ?? [])].sort((a, b) => a.code.localeCompare(b.code));
+  return (
+    <div className="field">
+      <label htmlFor={id}>Account</label>
+      <select
+        id={id}
+        name="account_id"
+        value={chosen}
+        onChange={(e) => {
+          setChosen(e.target.value);
+        }}
+      >
+        <option value="">All accounts</option>
+        {accounts.map((a) => (
+          <option key={a.id} value={a.id}>
+            {a.code} {a.name}
+          </option>
+        ))}
+        {value && !accounts.some((a) => a.id === value) ? (
+          <option value={value}>The chosen account</option>
+        ) : null}
+      </select>
+    </div>
+  );
+}
+
+export function GlDetailPage({ search }: { search: GlDetailSearch }) {
+  const { reports } = useServices();
+  const navigate = useNavigate();
+  const range = dateRange(search, localToday(), true);
+  const gate = useReportGate('reports.run', 'general ledger detail');
+  const co = gate.company;
+  const q = useQuery({
+    queryKey: [
+      'reports',
+      'gl',
+      co?.id ?? '',
+      range.from,
+      range.to,
+      search.account_id ?? '',
+      search.party_id ?? '',
+    ],
+    queryFn: () =>
+      reports.glDetail(co?.id ?? '', {
+        ...range,
+        accountId: search.account_id,
+        partyId: search.party_id,
+      }),
+    enabled: !!co,
+  });
+  const gl = q.data;
+  // The account list is loaded by the picker; it is keyed so a new URL resets the form.
+  const formKey = `${range.from ?? ''}|${range.to}|${search.account_id ?? ''}`;
+
+  let body = gate.blocked;
+  if (!body) {
+    const state = queryState(q, 'general ledger detail');
+    body = (
+      <>
+        <ReportFilters
+          key={formKey}
+          fields={[
+            {
+              name: 'from',
+              label: 'From',
+              value: range.from ?? '',
+              required: false,
+              hint: 'Leave empty to start at the beginning of your books.',
+            },
+            { name: 'to', label: 'To', value: range.to },
+          ]}
+          extra={<AccountPicker value={search.account_id ?? ''} />}
+          onShow={(v) =>
+            void navigate({
+              to: '/reports/gl-detail',
+              search: {
+                ...(v['from'] ? { from: v['from'] } : {}),
+                to: v['to'] ?? range.to,
+                ...(v['account_id'] ? { account_id: v['account_id'] } : {}),
+                ...(search.party_id ? { party_id: search.party_id } : {}),
+              },
+            })
+          }
+          csv={
+            gl && gl.accounts.length > 0
+              ? {
+                  fileName: `general-ledger-${range.from ?? 'start'}-to-${range.to}.csv`,
+                  content: () => glDetailCsv(gl),
+                }
+              : undefined
+          }
+        />
+        {search.party_id ? (
+          <p className="admin-note">
+            Showing the lines of one customer or supplier only.{' '}
+            <Link
+              to="/reports/gl-detail"
+              search={{
+                ...(range.from ? { from: range.from } : {}),
+                to: range.to,
+                ...(search.account_id ? { account_id: search.account_id } : {}),
+              }}
+            >
+              Show everyone
+            </Link>
+          </p>
+        ) : null}
+        {state ??
+          (gl && gl.accounts.length === 0 ? (
+            <Empty heading="Nothing posted in these dates">
+              No posted journal touches the chosen accounts in these dates.
+            </Empty>
+          ) : gl ? (
+            <div className="admin-block">
+              <ReportScope>
+                {co?.name}, {gl.from ? dayWords(gl.from) : 'the start of your books'} to{' '}
+                {dayWords(gl.to)}. Amounts in {gl.currency}; credit balances in brackets.
+              </ReportScope>
+              {gl.accounts.map((a) => (
+                <section key={a.account_id} className="report-account">
+                  <h2>
+                    <span className="code">{a.code}</span> {a.name}
+                  </h2>
+                  <table className="admin-table report-lines" aria-label={`${a.code} ${a.name}`}>
+                    <thead>
+                      <tr>
+                        <th scope="col">Date</th>
+                        <th scope="col">Entry</th>
+                        <th scope="col">Details</th>
+                        <th scope="col" className="num">
+                          Debit
+                        </th>
+                        <th scope="col" className="num">
+                          Credit
+                        </th>
+                        <th scope="col" className="num">
+                          Balance
+                        </th>
+                      </tr>
+                    </thead>
+                    <tbody>
+                      <tr className="report-edge">
+                        <td data-label="Date">{gl.from ? dayWords(gl.from) : 'Start'}</td>
+                        <td data-label="Entry" colSpan={4}>
+                          Opening balance
+                        </td>
+                        <td data-label="Balance" className="num">
+                          <Money value={a.opening} />
+                        </td>
+                      </tr>
+                      {a.lines.map((l) => (
+                        <tr key={`${l.entry_id}-${String(l.line_no)}`}>
+                          <td data-label="Date">{dayWords(l.date)}</td>
+                          <td data-label="Entry">{l.entry_no ?? 'Unnumbered'}</td>
+                          <td data-label="Details">{details(l.memo, l.party_name) || '—'}</td>
+                          <td data-label="Debit" className="num">
+                            <Money value={l.debit} />
+                          </td>
+                          <td data-label="Credit" className="num">
+                            <Money value={l.credit} />
+                          </td>
+                          <td data-label="Balance" className="num">
+                            <Money value={l.balance} />
+                          </td>
+                        </tr>
+                      ))}
+                    </tbody>
+                    <tfoot>
+                      <tr className="report-edge">
+                        <td data-label="Date">{dayWords(gl.to)}</td>
+                        <td data-label="Entry" colSpan={2}>
+                          Closing balance
+                        </td>
+                        <td data-label="Debit" className="num">
+                          <Money value={a.total_debit} />
+                        </td>
+                        <td data-label="Credit" className="num">
+                          <Money value={a.total_credit} />
+                        </td>
+                        <td data-label="Balance" className="num">
+                          <Money value={a.closing} />
+                        </td>
+                      </tr>
+                    </tfoot>
+                  </table>
+                </section>
+              ))}
+            </div>
+          ) : null)}
+      </>
+    );
+  }
+
+  return (
+    <>
+      <PageHead
+        title="General ledger detail"
+        gloss="Every posted journal line behind an account's balance, with the running balance after each line."
+      />
+      {body}
+    </>
+  );
+}
diff --git a/apps/web/src/reports/ProfitAndLossPage.tsx b/apps/web/src/reports/ProfitAndLossPage.tsx
