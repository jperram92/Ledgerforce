+/**
+ * Profit and loss (T-0089, design §8.1, SS-RPT-02): income then expenses for the dates, grouped
+ * by account kind, and the net profit — all as the API returned them. Each line opens its
+ * general-ledger detail for the same dates (P1).
+ */
+import { useQuery } from '@tanstack/react-query';
+import { Link, useNavigate } from '@tanstack/react-router';
+import { formatMoney, Money } from '@ledgerforce/ui';
+import { PageHead } from '../admin/common.tsx';
+import { useServices } from '../env.tsx';
+import type { ProfitAndLoss } from './client.ts';
+import { queryState, ReportFilters, ReportScope, useReportGate } from './common.tsx';
+import { csvAmount, dateRange, dayWords, localToday, toCsv, type RangeSearch } from './logic.ts';
+import {
+  STATEMENT_CSV_HEADER,
+  statementCsvRows,
+  StatementTable,
+  type SectionSpec,
+} from './Statement.tsx';
+
+const sectionsOf = (pl: ProfitAndLoss): SectionSpec[] => [
+  { heading: 'Income', totalLabel: 'Total income', section: pl.revenue },
+  { heading: 'Expenses', totalLabel: 'Total expenses', section: pl.expenses },
+];
+
+const netLabel = (pl: ProfitAndLoss) =>
+  formatMoney(pl.net_profit).negative ? 'Net loss' : 'Net profit';
+
+export function profitAndLossCsv(pl: ProfitAndLoss): string {
+  return toCsv([
+    STATEMENT_CSV_HEADER,
+    ...statementCsvRows(sectionsOf(pl)),
+    ['', '', '', netLabel(pl), csvAmount(pl.net_profit)],
+  ]);
+}
+
+export function ProfitAndLossPage({ search }: { search: RangeSearch }) {
+  const { reports } = useServices();
+  const navigate = useNavigate();
+  const range = dateRange(search, localToday(), false);
+  const from = range.from ?? range.to;
+  const gate = useReportGate('reports.run', 'the profit and loss');
+  const co = gate.company;
+  const q = useQuery({
+    queryKey: ['reports', 'pl', co?.id ?? '', from, range.to],
+    queryFn: () => reports.profitAndLoss(co?.id ?? '', { from, to: range.to }),
+    enabled: !!co,
+  });
+  const pl = q.data;
+
+  let body = gate.blocked;
+  if (!body) {
+    const state = queryState(q, 'the profit and loss');
+    body = (
+      <>
+        <ReportFilters
+          key={`${from}|${range.to}`}
+          fields={[
+            { name: 'from', label: 'From', value: from },
+            { name: 'to', label: 'To', value: range.to },
+          ]}
+          onShow={(v) =>
+            void navigate({
+              to: '/reports/profit-and-loss',
+              search: { from: v['from'] ?? from, to: v['to'] ?? range.to },
+            })
+          }
+          csv={
+            pl
+              ? {
+                  fileName: `profit-and-loss-${from}-to-${range.to}.csv`,
+                  content: () => profitAndLossCsv(pl),
+                }
+              : undefined
+          }
+        />
+        {state ??
+          (pl ? (
+            <div className="admin-block">
+              <ReportScope>
+                {co?.name}, {dayWords(pl.from)} to {dayWords(pl.to)}. Amounts in {pl.currency};
+                losses in brackets.
+              </ReportScope>
+              <StatementTable
+                label="Profit and loss"
+                currency={pl.currency}
+                sections={sectionsOf(pl)}
+                lineLink={(l) => (
+                  <Link
+                    to="/reports/gl-detail"
+                    search={{ from: pl.from, to: pl.to, account_id: l.account_id }}
+                  >
+                    <span className="code">{l.code}</span> {l.name}
+                  </Link>
+                )}
+                footer={
+                  <tr>
+                    <th scope="row">{netLabel(pl)}</th>
+                    <td className="num">
+                      <Money value={pl.net_profit} />
+                    </td>
+                  </tr>
+                }
+              />
+            </div>
+          ) : null)}
+      </>
+    );
+  }
+
+  return (
+    <>
+      <PageHead
+        title="Profit and loss"
+        gloss="What you earned and spent in the dates you choose, from posted journals (income statement)."
+      />
+      {body}
+    </>
+  );
+}
diff --git a/apps/web/src/reports/Statement.tsx b/apps/web/src/reports/Statement.tsx
new file mode 100644
index 0000000..3f0631f
--- /dev/null
+++ b/apps/web/src/reports/Statement.tsx
@@ -0,0 +1,137 @@
+/**
+ * A financial statement table (T-0089): sections (income, expenses; assets, liabilities, equity),
+ * each grouped by account kind in plain words, with the totals the API returned. Group subtotals
+ * are shown only where they add something (several lines in a section of several groups).
+ * Lines link to their general-ledger detail (P1); lines the report works out are marked.
+ */
+import type { ReactNode } from 'react';
+import { Money } from '@ledgerforce/ui';
+import type { StatementLine, StatementSection } from './client.ts';
+import { csvAmount, csvText, subtypeWord } from './logic.ts';
+
+export interface SectionSpec {
+  heading: string;
+  totalLabel: string;
+  section: StatementSection;
+}
+
+const showSubtotal = (s: StatementSection, lines: number) => s.groups.length > 1 && lines > 1;
+
+export function StatementTable({
+  label,
+  currency,
+  sections,
+  lineLink,
+  footer,
+}: {
+  label: string;
+  currency: string;
+  sections: SectionSpec[];
+  lineLink: (line: StatementLine, subtype: string) => ReactNode;
+  footer: ReactNode;
+}) {
+  return (
+    <table className="report-table statement" aria-label={label}>
+      <thead>
+        <tr>
+          <th scope="col">Account</th>
+          <th scope="col" className="num">
+            {currency}
+          </th>
+        </tr>
+      </thead>
+      {sections.map(({ heading, totalLabel, section }) => (
+        <tbody key={heading}>
+          <tr className="report-section">
+            <th scope="rowgroup" colSpan={2}>
+              {heading}
+            </th>
+          </tr>
+          {section.groups.map((g) => (
+            <GroupRows
+              key={g.subtype}
+              group={g}
+              subtotal={showSubtotal(section, g.lines.length)}
+              lineLink={lineLink}
+            />
+          ))}
+          <tr className="report-total">
+            <th scope="row">{totalLabel}</th>
+            <td className="num">
+              <Money value={section.total} />
+            </td>
+          </tr>
+        </tbody>
+      ))}
+      <tfoot>{footer}</tfoot>
+    </table>
+  );
+}
+
+function GroupRows({
+  group,
+  subtotal,
+  lineLink,
+}: {
+  group: StatementSection['groups'][number];
+  subtotal: boolean;
+  lineLink: (line: StatementLine, subtype: string) => ReactNode;
+}) {
+  const word = subtypeWord(group.subtype);
+  return (
+    <>
+      <tr className="report-group">
+        <th scope="row" colSpan={2}>
+          {word}
+        </th>
+      </tr>
+      {group.lines.map((l) => (
+        <tr key={l.account_id}>
+          <th scope="row" className="report-line">
+            {lineLink(l, group.subtype)}
+            {l.computed ? (
+              <>
+                {' '}
+                <span className="word" data-status="computed">
+                  Worked out
+                </span>
+              </>
+            ) : null}
+          </th>
+          <td className="num">
+            <Money value={l.amount} />
+          </td>
+        </tr>
+      ))}
+      {subtotal ? (
+        <tr className="report-subtotal">
+          <th scope="row">Total {word.charAt(0).toLowerCase() + word.slice(1)}</th>
+          <td className="num">
+            <Money value={group.total} />
+          </td>
+        </tr>
+      ) : null}
+    </>
+  );
+}
+
+/** The same rows as CSV: Section, Kind, Code, Account, Amount. */
+export function statementCsvRows(sections: SectionSpec[]): string[][] {
+  const rows: string[][] = [];
+  for (const { heading, totalLabel, section } of sections) {
+    for (const g of section.groups) {
+      for (const l of g.lines)
+        rows.push([
+          csvText(heading),
+          csvText(subtypeWord(g.subtype)),
+          csvText(l.code),
+          csvText(l.computed ? `${l.name} (worked out)` : l.name),
+          csvAmount(l.amount),
+        ]);
+    }
+    rows.push([csvText(heading), '', '', csvText(totalLabel), csvAmount(section.total)]);
+  }
+  return rows;
+}
+
+export const STATEMENT_CSV_HEADER = ['Section', 'Kind', 'Code', 'Account', 'Amount'];
