+describe('SS-UC01-04: Above threshold stays Draft', () => {
+  it('auto-approve threshold $1,000 and a $1,375 invoice → Draft, reason ABOVE_THRESHOLD, no journal', async () => {
+    await autoApprove(true, '1000');
+    try {
+      const id = opp();
+      const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+      await createOpp(id, account, '2026-11-05', 1250);
+      await addLines(id, [
+        { product: PS, total: 1000 },
+        { product: SUB, total: 250 },
+      ]);
+      const before = await w.countEntries();
+      const r = await closeWon(id);
+      expect(r.source).toMatchObject({
+        status: 'drafted',
+        auto: { outcome: 'draft', reason: 'ABOVE_THRESHOLD' },
+      });
+      const [inv] = await invoicesOf(`sf:Opportunity:${id}`);
+      expect(inv?.status).toBe('draft');
+      expect(await w.countEntries()).toBe(before);
+    } finally {
+      await autoApprove(false, '0');
+    }
+  });
+
+  it('under the threshold the draft is approved and posted, and the write-back says Posted with the amount invoiced', async () => {
+    await autoApprove(true, '2000');
+    try {
+      const id = opp();
+      const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+      await createOpp(id, account, '2026-11-05', 1250);
+      await addLines(id, [
+        { product: PS, total: 1000 },
+        { product: SUB, total: 250 },
+      ]);
+      const before = await w.countEntries();
+      const sent = w.messages.length;
+      const r = await closeWon(id);
+      expect(r.source).toMatchObject({ status: 'drafted', auto: { outcome: 'posted' } });
+      const [inv] = await invoicesOf(`sf:Opportunity:${id}`);
+      expect(inv?.status).toBe('posted');
+      expect(await w.countEntries()).toBe(before + 1);
+      const doc = await w.inTenant((trx) => getSalesInvoice(trx, inv?.id ?? ''));
+      // One event with the final state (RQ-0124 F6, DL-0373): never a stale "Draft" after "Posted".
+      const events = w.messages.slice(sent);
+      expect(events.map((m) => m.topic)).toEqual(['invoice.posted']);
+      const recs = mapToRecords(parseWriteBackPayload(events[0]?.payload));
+      expect(recs.find((x) => x.sobject === 'Opportunity')?.fields).toEqual({
+        LF_Invoice_Status__c: 'Posted',
+        LF_Amount_Invoiced__c: new SfNumber('1375.00'),
+      });
+      expect(recs.find((x) => x.sobject === 'LF_Invoice__c')?.fields).toMatchObject({
+        Name: doc.invoiceNo,
+        LF_Status__c: 'Posted',
+        LF_Total__c: new SfNumber('1375.00'),
+        LF_Amount_Due__c: new SfNumber('1375.00'),
+      });
+    } finally {
+      await autoApprove(false, '0');
+    }
+  });
+});
