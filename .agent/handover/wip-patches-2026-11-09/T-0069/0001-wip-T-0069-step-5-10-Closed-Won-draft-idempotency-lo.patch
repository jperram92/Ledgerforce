+        triggerSource: 'order',
+        setBy: w.financeAdmin,
+        reason: 'tenant invoices on Order activation',
+      }),
+    );
+    try {
+      const r = await w.bill(
+        billingCdc1({
+          entity: 'Order',
+          recordIds: [order],
+          changeType: 'UPDATE',
+          commitNumber: nextCommit(),
+          fields: { Status: 'Live' },
+          changed: ['Status'],
+        }),
+      );
+      expect(r.source).toMatchObject({ status: 'drafted' });
+      const [inv] = await invoicesOf(`sf:Order:${order}`);
+      const doc = await w.inTenant((trx) => getSalesInvoice(trx, inv?.id ?? ''));
+      expect(doc).toMatchObject({ status: 'draft', invoiceDate: '2026-11-07' });
+      expect(doc.lines.map((l) => l.amount)).toEqual(['250.0000']);
+      const last = w.messages.at(-1);
+      const recs = mapToRecords(parseWriteBackPayload(last?.payload));
+      // No Opportunity to update for an Order; the invoice mirror links the Account only.
+      expect(recs.map((x) => x.sobject)).toEqual(['LF_Invoice__c']);
+      expect(recs[0]?.fields).not.toHaveProperty('LF_Opportunity__c');
+    } finally {
+      await w.inTenant((trx) =>
+        setBillingSettings(trx, {
+          companyId: w.companyId,
+          triggerSource: 'opportunity',
+          setBy: w.financeAdmin,
+          reason: 'back to the default',
+        }),
+      );
+    }
+  });
+});
+
+describe('billing tables are append-only facts', () => {
+  it('lf_app cannot delete a trigger, change its invoice, or delete a billing record', async () => {
+    const id = opp();
+    const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+    await createOpp(id, account, '2026-11-05', 250);
+    await addLines(id, [{ product: SUB, total: 250 }]);
+    await closeWon(id);
+    const refuse = (q: ReturnType<typeof sql>) =>
+      w
+        .inTenant((trx) => q.execute(trx))
+        .then(
+          () => 'accepted',
+          (e: unknown) => String((e as Error).message),
+        );
+    expect(
+      await refuse(sql`DELETE FROM app.salesforce_billing_trigger WHERE record_id = ${id}`),
+    ).toMatch(/permission denied/);
+    expect(
+      await refuse(
+        sql`UPDATE app.salesforce_billing_trigger SET invoice_id = invoice_id WHERE record_id = ${id}`,
+      ),
+    ).toMatch(/permission denied/);
+    expect(
+      await refuse(sql`DELETE FROM app.salesforce_billing_record WHERE record_id = ${id}`),
+    ).toMatch(/permission denied/);
+  });
+});
diff --git a/packages/connectors/salesforce/src/billing/source.contract.test.ts b/packages/connectors/salesforce/src/billing/source.contract.test.ts
new file mode 100644
index 0000000..56d4471
--- /dev/null
+++ b/packages/connectors/salesforce/src/billing/source.contract.test.ts
@@ -0,0 +1,217 @@
+/**
+ * Billing-source contract (T-0069, UC-01, RQ-0124): Opportunity / OpportunityLineItem / Order /
+ * OrderItem change events from the documented fixture schemas (Avro encode → decode → changes,
+ * exactly as production), the won / activated rule, and the draft plan built from the remembered
+ * header and line states. No database, no org.
+ */
+import { describe, expect, it } from 'vitest';
+import { billingCdc1, billingId, epochDay } from '../testing/billing-events.ts';
+import { sfId } from '../testing/master-data-events.ts';
+import {
+  DEFAULT_BILLING_SETTINGS,
+  isTriggered,
+  planDraft,
+  sfDate,
+  sfMoney,
+  sourceOf,
+} from './source.ts';
+
+const OPP = billingId('006', 1);
+const ACC = sfId('001', 1);
+const PS = sfId('01t', 1);
+const SUB = sfId('01t', 2);
+
+describe('billing change events (documented fixture schemas)', () => {
+  it('an Opportunity UPDATE carries only the named fields, dates as YYYY-MM-DD and money as decimal text', () => {
+    const c = billingCdc1({
+      entity: 'Opportunity',
+      recordIds: [OPP],
+      changeType: 'UPDATE',
+      commitNumber: 501n,
+      fields: {
+        StageName: 'Closed Won',
+        IsWon: true,
+        CloseDate: epochDay('2026-11-05'),
+        Amount: 1250,
+      },
+      changed: ['StageName', 'IsWon', 'CloseDate', 'Amount'],
+    });
+    expect(c).toMatchObject({
+      entity: 'Opportunity',
+      recordId: OPP,
+      op: 'upsert',
+      key: `cdc:Opportunity:${OPP}:501:1`,
+      fields: { StageName: 'Closed Won', IsWon: true, CloseDate: '2026-11-05', Amount: '1250' },
+    });
+    expect(Object.keys(c.fields).sort()).toEqual(['Amount', 'CloseDate', 'IsWon', 'StageName']);
+  });
+
+  it('an OpportunityLineItem CREATE names its Opportunity (the source) and keeps cents exactly', () => {
+    const line = billingId('00k', 1);
+    const c = billingCdc1({
+      entity: 'OpportunityLineItem',
+      recordIds: [line],
+      changeType: 'CREATE',
+      commitNumber: 502n,
+      fields: {
+        OpportunityId: OPP,
+        Product2Id: PS,
+        Quantity: 1,
+        UnitPrice: 1000.1,
+        TotalPrice: 1000.1,
+      },
+    });
+    expect(c.fields).toMatchObject({ OpportunityId: OPP, TotalPrice: '1000.1', Quantity: '1' });
+    expect(sourceOf(c.entity, c.recordId, c.fields)).toEqual({
+      entity: 'Opportunity',
+      recordId: OPP,
+    });
+    expect(sourceOf('Opportunity', OPP, {})).toEqual({ entity: 'Opportunity', recordId: OPP });
+  });
+
+  it('an event with no new records gives no billing change', () => {
+    expect(() =>
+      billingCdc1({ entity: 'Order', recordIds: [], changeType: 'UPDATE', commitNumber: 1n }),
+    ).toThrow(/no change/);
+  });
+});
+
+describe('sfMoney / sfDate — no floating-point arithmetic, no rounding', () => {
+  it('turns Avro doubles into exact decimal text and refuses digits beyond the cent', () => {
+    expect(sfMoney(1000)).toBe('1000.00');
+    expect(sfMoney(250.5)).toBe('250.50');
+    expect(sfMoney('1375.0000')).toBe('1375.00');
+    expect(sfMoney(0)).toBe('0.00');
+    expect(sfMoney(null)).toBeNull();
+    expect(() => sfMoney(0.1 + 0.2)).toThrow(/beyond the cent/);
+    expect(() => sfMoney(1e21)).toThrow(/not a decimal/);
+    expect(() => sfMoney('abc')).toThrow(/not a decimal/);
+  });
+
+  it('turns Avro date ints into YYYY-MM-DD and accepts polled dates', () => {
+    expect(sfDate(epochDay('2026-10-30'))).toBe('2026-10-30');
+    expect(sfDate('2026-11-05')).toBe('2026-11-05');
+    expect(sfDate(null)).toBeNull();
+    expect(() => sfDate('2026-13-01')).toThrow(/not a date/);
+  });
+});
+
+describe('won / activated rule (RQ-0124 F2)', () => {
+  const s = DEFAULT_BILLING_SETTINGS;
+  it('Opportunity: IsWon true, or the stage is a won stage name', () => {
+    expect(isTriggered('Opportunity', { StageName: 'Closed Won' }, s)).toBe(true);
+    expect(isTriggered('Opportunity', { StageName: 'Signed', IsWon: true }, s)).toBe(true);
+    expect(isTriggered('Opportunity', { StageName: 'Negotiation', IsWon: false }, s)).toBe(false);
+    expect(isTriggered('Opportunity', { StageName: 'Closed Lost', IsWon: false }, s)).toBe(false);
+    expect(
+      isTriggered('Opportunity', { StageName: 'Signed' }, { ...s, wonStages: ['Signed'] }),
+    ).toBe(true);
+  });
+  it('Order: StatusCode Activated', () => {
+    expect(isTriggered('Order', { StatusCode: 'Activated', Status: 'Live' }, s)).toBe(true);
+    expect(isTriggered('Order', { StatusCode: 'Draft', Status: 'Ready' }, s)).toBe(false);
+  });
+});
+
+describe('draft plan from remembered header and lines', () => {
+  const header = { AccountId: ACC, CloseDate: '2026-11-05', Amount: '1250' };
+  const line = (
+    n: number,
+    product: string,
+    total: string,
+    extra: Record<string, unknown> = {},
+  ) => ({
+    recordId: billingId('00k', n),
+    fields: { OpportunityId: OPP, Product2Id: product, TotalPrice: total, ...extra },
+  });
+
+  it('two lines in SortOrder, amounts in cents, date and account from the Opportunity', () => {
+    const p = planDraft('Opportunity', header, [
+      line(2, SUB, '250', { SortOrder: '2', Description: 'Subscription' }),
+      line(1, PS, '1000', { SortOrder: '1', Description: 'Professional services' }),
+    ]);
+    expect(p).toEqual({
+      ok: true,
+      accountId: ACC,
+      date: '2026-11-05',
+      currency: null,
+      total: '1250.00',
+      lines: [
+        {
+          recordId: billingId('00k', 1),
+          productId: PS,
+          amount: '1000.00',
+          description: 'Professional services',
+        },
+        {
+          recordId: billingId('00k', 2),
+          productId: SUB,
+          amount: '250.00',
+          description: 'Subscription',
+        },
+      ],
+      skipped: [],
+    });
+  });
+
+  it('no lines → NO_LINES; lines short of the rolled-up Amount → LINES_INCOMPLETE (wait for them)', () => {
+    expect(planDraft('Opportunity', header, [])).toMatchObject({ ok: false, code: 'NO_LINES' });
+    expect(planDraft('Opportunity', header, [line(1, PS, '1000')])).toMatchObject({
+      ok: false,
+      code: 'LINES_INCOMPLETE',
+    });
+  });
+
+  it('a zero-priced line is skipped and reported; a negative or sub-cent line refuses the source', () => {
+    const p = planDraft('Opportunity', { ...header, Amount: '1000' }, [
+      line(1, PS, '1000'),
+      line(2, SUB, '0'),
+    ]);
+    expect(p).toMatchObject({
+      ok: true,
+      lines: [{ productId: PS }],
+      skipped: [billingId('00k', 2)],
+    });
+    expect(planDraft('Opportunity', header, [line(1, PS, '-5')])).toMatchObject({
+      ok: false,
+      code: 'INVALID_SOURCE',
+    });
+    expect(planDraft('Opportunity', header, [line(1, PS, '1250.001')])).toMatchObject({
+      ok: false,
+      code: 'INVALID_SOURCE',
+    });
+  });
+
+  it('missing account, date or product refuses the source with a reason', () => {
+    expect(
+      planDraft('Opportunity', { ...header, AccountId: null }, [line(1, PS, '1250')]),
+    ).toMatchObject({
+      ok: false,
+      code: 'INVALID_SOURCE',
+    });
+    expect(
+      planDraft('Opportunity', { ...header, CloseDate: null }, [line(1, PS, '1250')]),
+    ).toMatchObject({
+      ok: false,
+      code: 'INVALID_SOURCE',
+    });
+    expect(planDraft('Opportunity', header, [line(1, 'nope', '1250')])).toMatchObject({
+      ok: false,
+      code: 'INVALID_SOURCE',
+    });
+  });
+
+  it('Order: EffectiveDate and TotalAmount', () => {
+    const p = planDraft(
+      'Order',
+      { AccountId: ACC, EffectiveDate: '2026-11-07', TotalAmount: '250', CurrencyIsoCode: 'AUD' },
+      [
+        {
+          recordId: billingId('802', 1),
+          fields: { OrderId: billingId('801', 1), Product2Id: SUB, TotalPrice: '250' },
+        },
+      ],
+    );
+    expect(p).toMatchObject({ ok: true, date: '2026-11-07', currency: 'AUD', total: '250.00' });
+  });
+});
diff --git a/packages/connectors/salesforce/src/billing/source.ts b/packages/connectors/salesforce/src/billing/source.ts
new file mode 100644
index 0000000..ca1e24b
--- /dev/null
+++ b/packages/connectors/salesforce/src/billing/source.ts
@@ -0,0 +1,299 @@
+/**
+ * Billing sources (T-0069, UC-01, design §4.3, §5.3; RQ-0124). An Opportunity with its
+ * OpportunityLineItems, or an Order with its OrderItems, is the Salesforce-owned billing source
+ * of one standard invoice (design §5.5). This file is pure: it turns CDC events into versioned
+ * per-record changes (the same patch rules as the T-0065 master data), normalises Avro values
+ * (dates, currency doubles) into text without floating-point arithmetic, decides whether a source
+ * is won / activated, and plans the draft invoice from the remembered header and line states.
+ */
+import { toSalesforceId18 } from '@ledgerforce/parties';
+import { Money } from '@ledgerforce/shared/money';
+import { cdcChangesOf, type EntityChange, type SfState } from '../inbound/changes.ts';
+import type { DecodedEvent } from '../pubsub/avro.ts';
+
+export type SourceEntity = 'Opportunity' | 'Order';
+export type LineEntity = 'OpportunityLineItem' | 'OrderItem';
+export type BillingEntity = SourceEntity | LineEntity;
+export const BILLING_ENTITIES: readonly BillingEntity[] = [
+  'Opportunity',
+  'OpportunityLineItem',
+  'Order',
+  'OrderItem',
+];
+
+export type BillingChange = EntityChange<BillingEntity>;
+
+/** The line entity of a source, the field naming its source, and the reverse. */
+export const LINE_OF: Readonly<Record<SourceEntity, LineEntity>> = {
+  Opportunity: 'OpportunityLineItem',
+  Order: 'OrderItem',
+};
+export const SOURCE_OF: Readonly<Record<LineEntity, SourceEntity>> = {
+  OpportunityLineItem: 'Opportunity',
+  OrderItem: 'Order',
+};
+export const PARENT_FIELD: Readonly<Record<LineEntity, string>> = {
+  OpportunityLineItem: 'OpportunityId',
+  OrderItem: 'OrderId',
+};
+/** Invoice date and the rolled-up total of a source (RQ-0124 F3, F6). */
+const DATE_FIELD: Readonly<Record<SourceEntity, string>> = {
+  Opportunity: 'CloseDate',
+  Order: 'EffectiveDate',
+};
+const TOTAL_FIELD: Readonly<Record<SourceEntity, string>> = {
+  Opportunity: 'Amount',
+  Order: 'TotalAmount',
+};
+const DATE_FIELDS = new Set(['CloseDate', 'EffectiveDate']);
+const NUMBER_FIELDS = new Set([
+  'Amount',
+  'TotalAmount',
+  'Quantity',
+  'UnitPrice',
+  'TotalPrice',
+  'SortOrder',
+]);
+
+const isBillingEntity = (e: string): e is BillingEntity =>
+  (BILLING_ENTITIES as string[]).includes(e);
+export const isLineEntity = (e: BillingEntity): e is LineEntity =>
+  e === 'OpportunityLineItem' || e === 'OrderItem';
+
+/** A Salesforce value the billing trigger cannot read (the source is refused with the reason). */
+export class BillingValueError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'BillingValueError';
+  }
+}
+
+const DECIMAL_RE = /^-?\d+(\.\d+)?$/;
+
+/**
+ * Exact decimal text of a Salesforce currency/number value. An Avro `double` becomes its shortest
+ * round-trip decimal (ECMAScript Number→String) and is parsed as text; nothing is computed in
+ * floating point. Digits beyond the cent are refused, never rounded. Returns two decimals.
+ */
+export function sfMoney(v: unknown): string | null {
+  if (v === null || v === undefined) return null;
+  const text = typeof v === 'number' ? String(v) : typeof v === 'string' ? v.trim() : '';
+  if (!DECIMAL_RE.test(text)) {
+    throw new BillingValueError(`${JSON.stringify(v)} is not a decimal amount`);
+  }
+  const frac = text.split('.')[1] ?? '';
+  if (/[^0]/.test(frac.slice(2))) {
+    throw new BillingValueError(`${text} has digits beyond the cent`);
+  }
+  const [int = '0'] = text.split('.');
+  const cents = frac.slice(0, 2).padEnd(2, '0');
+  return `${int.replace(/^(-?)0+(?=\d)/, '$1')}.${cents}`;
+}
+
+/** YYYY-MM-DD of a Salesforce Date: Avro int days since 1970-01-01 (UTC) or polled text. */
+export function sfDate(v: unknown): string | null {
+  if (v === null || v === undefined) return null;
+  let d: Date;
+  if (typeof v === 'number' && Number.isSafeInteger(v)) d = new Date(v * 86_400_000);
+  else if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v)) d = new Date(`${v}T00:00:00Z`);
+  else throw new BillingValueError(`${JSON.stringify(v)} is not a date`);
+  const iso = Number.isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 10);
+  if (iso === '' || (typeof v === 'string' && iso !== v)) {
+    throw new BillingValueError(`${JSON.stringify(v)} is not a date`);
+  }
+  return iso;
+}
+
+/**
+ * Field values as stored: dates as YYYY-MM-DD, numbers as decimal text (no float survives into
+ * the database). A value that cannot be read stays as delivered; planDraft refuses it by name.
+ */
+function normalise(fields: SfState): SfState {
+  const out: SfState = {};
+  for (const [k, v] of Object.entries(fields)) {
+    try {
+      if (DATE_FIELDS.has(k)) out[k] = sfDate(v);
+      else if (NUMBER_FIELDS.has(k) && typeof v === 'number') out[k] = String(v);
+      else out[k] = v;
+    } catch {
+      out[k] = v;
+    }
+  }
+  return out;
+}
+
+/** One change per new record of an Opportunity/OpportunityLineItem/Order/OrderItem CDC event. */
+export function billingChangesFromCdcEvent(
+  e: DecodedEvent,
+  recordIds: readonly string[],
+): BillingChange[] {
+  return cdcChangesOf(e, recordIds, isBillingEntity).map((c) => ({
+    ...c,
+    fields: normalise(c.fields),
+  }));
+}
+
+const id18 = (v: unknown): string | null => {
+  if (typeof v !== 'string') return null;
+  try {
+    return toSalesforceId18(v);
+  } catch {
+    return null;
+  }
+};
+
+/** The source a record belongs to: a header is its own source, a line names it. */
+export function sourceOf(
+  entity: BillingEntity,
+  recordId: string,
+  fields: SfState,
+): { entity: SourceEntity; recordId: string } | null {
+  if (!isLineEntity(entity)) return { entity, recordId };
+  const parent = id18(fields[PARENT_FIELD[entity]]);
+  return parent === null ? null : { entity: SOURCE_OF[entity], recordId: parent };
+}
+
+export interface BillingSettings {
+  /** Design §11.2 is open: both are built, default Opportunity (RQ-0124 F1). */
+  triggerSource: 'opportunity' | 'order';
+  wonStages: string[];
+  paymentTermsDays: number;
+}
+
+export const DEFAULT_BILLING_SETTINGS: Readonly<BillingSettings> = Object.freeze({
+  triggerSource: 'opportunity',
+  wonStages: ['Closed Won'],
+  paymentTermsDays: 14,
+});
+
+export const TRIGGER_ENTITY: Readonly<Record<BillingSettings['triggerSource'], SourceEntity>> = {
+  opportunity: 'Opportunity',
+  order: 'Order',
+};
+
+/** Won (IsWon, or a won stage name) / activated (StatusCode Activated) — RQ-0124 F2. */
+export function isTriggered(entity: SourceEntity, state: SfState, s: BillingSettings): boolean {
+  if (entity === 'Order') return state.StatusCode === 'Activated';
+  if (state.IsWon === true) return true;
+  return typeof state.StageName === 'string' && s.wonStages.includes(state.StageName);
+}
+
+export type BlockingCode =
+  | 'NO_LINES'
+  | 'LINES_INCOMPLETE'
+  | 'UNKNOWN_ACCOUNT'
+  | 'UNKNOWN_PRODUCT'
+  | 'INVALID_SOURCE'
+  | 'PERIOD_LOCKED'
+  | 'INVOICE_REFUSED';
+
+export interface PlannedLine {
+  recordId: string;
+  /** Salesforce Product2 Id (18). */
+  productId: string;
+  /** Tax-exclusive, two decimals. */
+  amount: string;
+  description: string | null;
+}
+
+export type DraftPlan =
+  | {
+      ok: true;
+      accountId: string;
+      date: string;
+      currency: string | null;
+      total: string;
+      lines: PlannedLine[];
+      /** Zero-priced line records left off the invoice (reported as a warning). */
+      skipped: string[];
+    }
+  | { ok: false; code: BlockingCode; message: string };
+
+const refuse = (code: BlockingCode, message: string): DraftPlan => ({ ok: false, code, message });
+
+const sortKey = (fields: SfState): number => {
+  const v = fields.SortOrder;
+  const n = typeof v === 'string' && /^\d+$/.test(v) ? Number.parseInt(v, 10) : Number.NaN;
+  return Number.isNaN(n) ? Number.MAX_SAFE_INTEGER : n;
+};
+
+/**
+ * The draft of a won / activated source from its remembered header and live line states, or the
+ * reason there is none yet. Lines must add up to the header's rolled-up total (cross-channel
+ * events are unordered, RQ-0124 F3).
+ */
+export function planDraft(
+  entity: SourceEntity,
+  header: SfState,
+  lines: readonly { recordId: string; fields: SfState }[],
+): DraftPlan {
+  const accountId = id18(header.AccountId);
+  if (accountId === null) {
+    return refuse('INVALID_SOURCE', `${entity} has no valid AccountId`);
+  }
+  let date: string | null;
+  let declared: string | null;
+  try {
+    date = sfDate(header[DATE_FIELD[entity]]);
+    declared = sfMoney(header[TOTAL_FIELD[entity]]);
+  } catch (e) {
+    return refuse('INVALID_SOURCE', `${entity}: ${(e as Error).message}`);
+  }
+  if (date === null) return refuse('INVALID_SOURCE', `${entity} has no ${DATE_FIELD[entity]}`);
+  const currency = typeof header.CurrencyIsoCode === 'string' ? header.CurrencyIsoCode : null;
+  if (lines.length === 0) {
+    return refuse(
+      'NO_LINES',
+      `${entity} has no line items in LedgerForce yet; the draft is created when they arrive`,
+    );
+  }
+  const planned: PlannedLine[] = [];
+  const skipped: string[] = [];
+  let total = Money.zero('XXX');
+  const ordered = [...lines].sort(
+    (a, b) => sortKey(a.fields) - sortKey(b.fields) || a.recordId.localeCompare(b.recordId),
+  );
+  for (const l of ordered) {
+    let amount: string | null;
+    try {
+      amount = sfMoney(l.fields.TotalPrice);
+    } catch (e) {
+      return refuse('INVALID_SOURCE', `line ${l.recordId}: ${(e as Error).message}`);
+    }
+    if (amount === null) return refuse('INVALID_SOURCE', `line ${l.recordId} has no TotalPrice`);
+    const m = Money.of(amount, 'XXX');
+    if (m.isNegative()) {
+      return refuse(
+        'INVALID_SOURCE',
+        `line ${l.recordId}: negative TotalPrice ${amount} (credit lines are not invoiced; issue a credit note)`,
+      );
+    }
+    total = total.add(m);
+    if (m.isZero()) {
+      skipped.push(l.recordId);
+      continue;
+    }
+    const productId = id18(l.fields.Product2Id);
+    if (productId === null) {
+      return refuse('INVALID_SOURCE', `line ${l.recordId} has no valid Product2Id`);
+    }
+    const d = l.fields.Description;
+    planned.push({
+      recordId: l.recordId,
+      productId,
+      amount,
+      description: typeof d === 'string' && d.trim() !== '' ? d.slice(0, 1000) : null,
+    });
+  }
+  const sum = sfMoney(total.toNumericString()) ?? '0.00';
+  if (declared !== null && !Money.of(declared, 'XXX').equals(total)) {
+    return refuse(
+      'LINES_INCOMPLETE',
+      `${entity} ${TOTAL_FIELD[entity]} is ${declared} but its line items in LedgerForce add up to ${sum}; the draft is created when the lines arrive`,
+    );
+  }
+  if (planned.length === 0) {
+    return refuse('NO_LINES', `${entity} has only zero-priced line items; nothing to invoice`);
+  }
+  return { ok: true, accountId, date, currency, total: sum, lines: planned, skipped };
+}
