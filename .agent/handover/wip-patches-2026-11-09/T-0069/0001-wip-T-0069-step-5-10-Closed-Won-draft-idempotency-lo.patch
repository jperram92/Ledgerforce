+/**
+ * Closed Won Opportunity / activated Order → one draft sales invoice (T-0069, UC-01 main flow 1–6,
+ * A2–A4, A6; design §4.3, §5.4–§5.6; RQ-0124; migration 0044).
+ *
+ * Per billing change, inside the caller's tenant transaction (the CDC subscriber's batch):
+ *  1. Lock the record's state row; the same version is a duplicate, an older one stale — both are
+ *     counted with the key and nothing else happens (design §5.6 rule 1).
+ *  2. Merge the patch onto the remembered state and store it with the new version.
+ *  3. Evaluate the record's source (the header itself, or the line's Opportunity / Order):
+ *     - already drafted → count the event on the trigger row; never a second invoice;
+ *     - not the configured trigger (design §11.2 setting) or not won / activated → nothing;
+ *     - plan the draft (lines complete, account, products, currency); a gap is a billing issue
+ *       (Sync issues) and the source waits for its next change;
+ *     - the invoice date passes the tenant lock-date policy (T-0023): reject → PERIOD_LOCKED
+ *       issue, no draft; first open date → that date with the policy note as the memo;
+ *     - createSalesInvoice (T-0040) with the key sf:<Entity>:<Id>; each line is resolved through
+ *       the posting-profile matrix (T-0039): any refusal (PROFILE_GAP, TAX_CODE_CONFLICT, …) is a
+ *       warning on the trigger and auto-approve is not tried; otherwise autoApproveSalesInvoice
+ *       decides (threshold, Billing To, credit hold) and posts through the posting engine;
+ *     - one write-back event with the final status (invoice.drafted or invoice.posted, T-0067
+ *       contract v1) in the same transaction; the trigger row; open issues resolved.
+ *
+ * This module never writes ledger tables: posting is autoApproveSalesInvoice → packages/ledger.
+ */
+import {
+  autoApproveSalesInvoice,
+  createSalesInvoice,
+  getSalesInvoice,
+  loadInvoiceSettings,
+  SalesInvoiceError,
+  type AutoApproveResult,
+  type CreditHoldCheck,
+  type InvoiceNotifier,
+} from '@ledgerforce/ar';
+import type { Database } from '@ledgerforce/db';
+import {
+  PeriodLockedError,
+  PostingError,
+  resolvePostingDate,
+  type PostingOutbox,
+} from '@ledgerforce/ledger';
+import { enqueue, type OutboxMessage } from '@ledgerforce/outbox';
+import { toSalesforceId18 } from '@ledgerforce/parties';
+import { PostingProfileResolutionError, resolvePartyProductPosting } from '@ledgerforce/products';
+import { sql, type Transaction } from 'kysely';
+import {
+  compareVersion,
+  mergeState,
+  type RecordVersion,
+  type SfState,
+} from '../inbound/changes.ts';
+import type { CdcHandler } from '../pubsub/subscriber.ts';
+import {
+  billingChangesFromCdcEvent,
+  DEFAULT_BILLING_SETTINGS,
+  isLineEntity,
+  isTriggered,
+  LINE_OF,
+  planDraft,
+  sourceOf,
+  TRIGGER_ENTITY,
+  type BillingChange,
+  type BillingEntity,
+  type BillingSettings,
+  type BlockingCode,
+  type SourceEntity,
+} from './source.ts';
+
+type Trx = Transaction<Database>;
+
+/** Write-back topics (writeback/mapping.ts WRITEBACK_TOPICS). */
+export const INVOICE_DRAFTED_TOPIC = 'invoice.drafted';
+export const INVOICE_STATUS_POSTED_TOPIC = 'invoice.posted';
+export const SALES_INVOICE_AGGREGATE = 'sales_invoice';
+
+/** Where the write-back event goes: production is the transactional outbox (billingOutbox). */
+export interface BillingOutbox {
+  enqueue(trx: Trx, msg: OutboxMessage): Promise<unknown>;
+}
+
+/** The transactional outbox (ADR-0008): the event commits or rolls back with the draft. */
+export const billingOutbox = (boss: Parameters<typeof enqueue>[1]): BillingOutbox => ({
+  enqueue: (trx, msg) => enqueue(trx, boss, msg),
+});
+
+export interface BillingDeps {
+  outbox: BillingOutbox;
+  /** The posting engine's outbox hook for auto-posted invoices (ledgerOutbox in production). */
+  postingOutbox?: PostingOutbox;
+  /** Invoice email notice on auto-post (invoiceOutboxNotifier in production, T-0042). */
+  notifier?: InvoiceNotifier;
+  creditHold?: CreditHoldCheck;
+}
+
+export interface DraftWarning {
+  code: string;
+  /** Invoice line number, when the warning is about a line. */
+  lineNo: number | null;
+  message: string;
+  /** True for posting-profile refusals: the draft waits for a person (UC-01 A2). */
+  blocksAutoApprove: boolean;
+}
+
+export type SourceResult =
+  | { status: 'not_triggered' }
+  | { status: 'not_this_trigger'; triggerSource: BillingSettings['triggerSource'] }
+  | { status: 'waiting'; code: BlockingCode }
+  | { status: 'already_drafted'; invoiceId: string }
+  | {
+      status: 'drafted';
+      invoiceId: string;
+      warnings: DraftWarning[];
+      auto: AutoApproveResult | { outcome: 'draft'; reason: string };
+    };
+
+export interface BillingApplyResult {
+  outcome: 'applied' | 'duplicate' | 'stale' | 'rejected';
+  /** What happened to the record's source; null when the change was not applied. */
+  source: SourceResult | null;
+}
+
+export interface BillingRecord {
+  entity: BillingEntity;
+  recordId: string;
+  parentId: string | null;
+  state: 'live' | 'deleted';
+  fields: SfState;
+  version: RecordVersion;
+  lastKey: string;
+  duplicates: number;
+  stale: number;
+  lastSkippedKey: string | null;
+}
+
+export interface BillingTrigger {
+  id: string;
+  sourceEntity: SourceEntity;
+  recordId: string;
+  accountId: string;
+  invoiceId: string;
+  triggerKey: string;
+  sourceDate: string;
+  note: string | null;
+  warnings: DraftWarning[];
+  autoApprove: 'posted' | 'draft';
+  autoReason: string | null;
+  laterEvents: number;
+  lastEventKey: string | null;
+}
+
+export interface BillingIssue {
+  id: string;
+  sourceEntity: SourceEntity;
+  recordId: string;
+  code: BlockingCode;
+  message: string;
+  status: 'open' | 'resolved' | 'ignored';
+  occurrences: number;
+  lastKey: string;
+  payload: SfState;
+}
+
+// --- settings -----------------------------------------------------------------------------------
+
+/** The company's current trigger setting (latest row), else the defaults (RQ-0124 F1, F6). */
+export async function loadBillingSettings(trx: Trx, companyId: string): Promise<BillingSettings> {
+  const r = await sql<{
+    trigger_source: BillingSettings['triggerSource'];
+    won_stages: string[];
+    payment_terms_days: number;
+  }>`
+    SELECT trigger_source, won_stages, payment_terms_days FROM app.salesforce_billing_settings
+     WHERE company_id = ${companyId} ORDER BY set_at DESC, id DESC LIMIT 1`.execute(trx);
+  const row = r.rows[0];
+  return row
+    ? {
+        triggerSource: row.trigger_source,
+        wonStages: row.won_stages,
+        paymentTermsDays: row.payment_terms_days,
+      }
+    : { ...DEFAULT_BILLING_SETTINGS, wonStages: [...DEFAULT_BILLING_SETTINGS.wonStages] };
+}
+
+/** Record a new trigger setting (history); omitted values keep the current ones. */
+export async function setBillingSettings(
+  trx: Trx,
+  s: Partial<BillingSettings> & { companyId: string; setBy: string; reason: string },
+): Promise<void> {
+  const cur = await loadBillingSettings(trx, s.companyId);
+  const next = { ...cur, ...s };
+  await sql`
+    INSERT INTO app.salesforce_billing_settings
+      (company_id, trigger_source, won_stages, payment_terms_days, set_by, reason)
+    VALUES (${s.companyId}, ${next.triggerSource}, ${next.wonStages}::text[],
+            ${next.paymentTermsDays}, ${s.setBy}, ${s.reason})`.execute(trx);
+}
+
+// --- record state -------------------------------------------------------------------------------
+
+interface RecordRow {
+  entity: BillingEntity;
+  record_id: string;
+  parent_id: string | null;
+  state: 'live' | 'deleted';
+  fields: SfState;
+  commit_number: string | null;
+  sequence_number: number;
+  commit_at: Date;
+  last_key: string;
+  duplicates: number;
+  stale: number;
+  last_skipped_key: string | null;
+}
+
+const toRecord = (r: RecordRow): BillingRecord => ({
+  entity: r.entity,
+  recordId: r.record_id,
+  parentId: r.parent_id,
+  state: r.state,
+  fields: r.fields,
+  version: {
+    commitNumber: r.commit_number === null ? null : BigInt(r.commit_number),
+    sequenceNumber: r.sequence_number,
+    at: r.commit_at,
+  },
+  lastKey: r.last_key,
+  duplicates: r.duplicates,
+  stale: r.stale,
+  lastSkippedKey: r.last_skipped_key,
+});
+
+async function loadRecord(
+  trx: Trx,
+  companyId: string,
+  entity: BillingEntity,
+  recordId: string,
+  lock: boolean,
+): Promise<BillingRecord | null> {
+  const { rows } = await sql<RecordRow>`
+    SELECT entity, record_id, parent_id, state, fields, commit_number::text AS commit_number,
+           sequence_number, commit_at, last_key, duplicates, stale, last_skipped_key
+      FROM app.salesforce_billing_record
+     WHERE company_id = ${companyId} AND entity = ${entity} AND record_id = ${recordId}
+     ${lock ? sql`FOR UPDATE` : sql``}`.execute(trx);
+  const row = rows[0];
+  return row ? toRecord(row) : null;
+}
+
+export const getBillingRecord = (
+  trx: Trx,
+  companyId: string,
+  entity: BillingEntity,
+  recordId: string,
+) => loadRecord(trx, companyId, entity, recordId, false);
+
+async function saveRecord(
+  trx: Trx,
+  companyId: string,
+  c: BillingChange,
+  s: { parentId: string | null; state: 'live' | 'deleted'; fields: SfState },
+): Promise<void> {
+  const v = c.version;
+  await sql`
+    INSERT INTO app.salesforce_billing_record
+      (company_id, entity, record_id, parent_id, state, fields, commit_number, sequence_number,
+       commit_at, last_key)
+    VALUES (${companyId}, ${c.entity}, ${c.recordId}, ${s.parentId}, ${s.state},
+            ${JSON.stringify(s.fields)}::jsonb, ${v.commitNumber?.toString() ?? null}::bigint,
+            ${v.sequenceNumber}, ${v.at}, ${c.key})
+    ON CONFLICT (tenant_id, company_id, entity, record_id) DO UPDATE SET
+      parent_id = EXCLUDED.parent_id,
+      state = EXCLUDED.state,
+      fields = EXCLUDED.fields,
+      commit_number = EXCLUDED.commit_number,
+      sequence_number = EXCLUDED.sequence_number,
+      commit_at = EXCLUDED.commit_at,
+      last_key = EXCLUDED.last_key`.execute(trx);
+}
+
+async function countSkipped(
+  trx: Trx,
+  companyId: string,
+  c: BillingChange,
+  kind: 'duplicate' | 'stale',
+): Promise<void> {
+  const counter = kind === 'duplicate' ? sql`duplicates` : sql`stale`;
+  await sql`
+    UPDATE app.salesforce_billing_record
+       SET ${counter} = ${counter} + 1, last_skipped_key = ${c.key},
+           last_skipped_at = clock_timestamp()
+     WHERE company_id = ${companyId} AND entity = ${c.entity} AND record_id = ${c.recordId}`.execute(
+    trx,
+  );
+}
+
+// --- triggers and issues ------------------------------------------------------------------------
+
+interface TriggerRow {
+  id: string;
+  source_entity: SourceEntity;
+  record_id: string;
+  account_id: string;
+  invoice_id: string;
+  trigger_key: string;
+  source_date: string;
+  note: string | null;
+  warnings: DraftWarning[];
+  auto_approve: 'posted' | 'draft';
+  auto_reason: string | null;
+  later_events: number;
+  last_event_key: string | null;
+}
+
+async function loadTrigger(
+  trx: Trx,
+  companyId: string,
+  entity: SourceEntity,
+  recordId: string,
+): Promise<BillingTrigger | null> {
+  const { rows } = await sql<TriggerRow>`
+    SELECT id::text, source_entity, record_id, account_id, invoice_id::text, trigger_key,
+           to_char(source_date, 'YYYY-MM-DD') AS source_date, note, warnings, auto_approve,
+           auto_reason, later_events, last_event_key
+      FROM app.salesforce_billing_trigger
+     WHERE company_id = ${companyId} AND source_entity = ${entity} AND record_id = ${recordId}`.execute(
+    trx,
+  );
+  const r = rows[0];
+  if (!r) return null;
+  return {
+    id: r.id,
+    sourceEntity: r.source_entity,
+    recordId: r.record_id,
+    accountId: r.account_id,
+    invoiceId: r.invoice_id,
+    triggerKey: r.trigger_key,
+    sourceDate: r.source_date,
+    note: r.note,
+    warnings: r.warnings,
+    autoApprove: r.auto_approve,
+    autoReason: r.auto_reason,
+    laterEvents: r.later_events,
+    lastEventKey: r.last_event_key,
+  };
+}
+
+export const getBillingTrigger = loadTrigger;
+
+/** Raise (or bump) the live issue of `code` for a source; other live issues of it are resolved. */
+async function raiseIssue(
+  trx: Trx,
+  companyId: string,
+  src: { entity: SourceEntity; recordId: string },
+  code: BlockingCode,
+  message: string,
+  payload: SfState,
+  key: string,
+): Promise<void> {
+  const text = message.slice(0, 1000);
+  const updated = await sql`
+    UPDATE app.salesforce_billing_issue
+       SET occurrences = occurrences + 1, message = ${text},
+           payload = ${JSON.stringify(payload)}::jsonb, last_key = ${key},
+           last_seen_at = clock_timestamp()
+     WHERE company_id = ${companyId} AND source_entity = ${src.entity}
+       AND record_id = ${src.recordId} AND code = ${code} AND status IN ('open', 'ignored')`.execute(
+    trx,
+  );
+  if (Number(updated.numAffectedRows ?? 0n) === 0) {
+    await sql`
+      INSERT INTO app.salesforce_billing_issue
+        (company_id, source_entity, record_id, code, message, payload, last_key)
+      VALUES (${companyId}, ${src.entity}, ${src.recordId}, ${code}, ${text},
+              ${JSON.stringify(payload)}::jsonb, ${key})`.execute(trx);
+  }
+  await resolveIssues(trx, companyId, src, key, code);
+}
+
+/** Resolve the source's live issues (except `keep`): the problem no longer occurs. */
+async function resolveIssues(
+  trx: Trx,
+  companyId: string,
+  src: { entity: SourceEntity; recordId: string },
+  key: string,
+  keep: BlockingCode | null = null,
+): Promise<void> {
+  await sql`
+    UPDATE app.salesforce_billing_issue
+       SET status = 'resolved', resolved_at = clock_timestamp(), last_key = ${key}
+     WHERE company_id = ${companyId} AND source_entity = ${src.entity}
+       AND record_id = ${src.recordId} AND status IN ('open', 'ignored')
+       ${keep === null ? sql`` : sql`AND code <> ${keep}`}`.execute(trx);
+}
+
+export async function listBillingIssues(trx: Trx, companyId: string): Promise<BillingIssue[]> {
+  const { rows } = await sql<{
+    id: string;
+    source_entity: SourceEntity;
+    record_id: string;
+    code: BlockingCode;
+    message: string;
+    status: BillingIssue['status'];
+    occurrences: number;
+    last_key: string;
+    payload: SfState;
+  }>`
+    SELECT id::text, source_entity, record_id, code, message, status, occurrences, last_key, payload
+      FROM app.salesforce_billing_issue
+     WHERE company_id = ${companyId}
+     ORDER BY first_seen_at, id`.execute(trx);
+  return rows.map((r) => ({
+    id: r.id,
+    sourceEntity: r.source_entity,
+    recordId: r.record_id,
+    code: r.code,
+    message: r.message,
+    status: r.status,
+    occurrences: r.occurrences,
+    lastKey: r.last_key,
+    payload: r.payload,
+  }));
+}
+
+// --- evaluation ---------------------------------------------------------------------------------
+
+const addDays = (date: string, days: number): string => {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().slice(0, 10);
+};
+
+/** The posting-profile refusals of the draft's lines, as warnings (UC-01 A2, SS-UC01-06). */
+async function draftWarnings(
+  trx: Trx,
+  companyId: string,
+  partyId: string,
+  productIds: readonly string[],
+): Promise<DraftWarning[]> {
+  const out: DraftWarning[] = [];
+  for (const [i, productId] of productIds.entries()) {
+    try {
+      await resolvePartyProductPosting(trx, {
+        companyId,
+        partyId,
+        productId,
+        direction: 'sale',
+        slot: 'revenue',
+      });
+    } catch (e) {
+      if (!(e instanceof PostingProfileResolutionError)) throw e;
+      out.push({ code: e.code, lineNo: i + 1, message: e.message, blocksAutoApprove: true });
+    }
+  }
+  return out;
+}
+
+/** Auto-approve in a savepoint: an engine refusal leaves the draft untouched, with the reason. */
+async function tryAutoApprove(
+  trx: Trx,
+  companyId: string,
+  invoiceId: string,
+  deps: BillingDeps,
+): Promise<AutoApproveResult | { outcome: 'draft'; reason: string }> {
+  const settings = await loadInvoiceSettings(trx, companyId);
+  await sql`SAVEPOINT lf_billing_auto`.execute(trx);
+  try {
+    const r = await autoApproveSalesInvoice(trx, {
+      id: invoiceId,
+      settings,
+      ...(deps.creditHold === undefined ? {} : { creditHold: deps.creditHold }),
+      ...(deps.postingOutbox === undefined ? {} : { outbox: deps.postingOutbox }),
+      ...(deps.notifier === undefined ? {} : { notifier: deps.notifier }),
+    });
+    await sql`RELEASE SAVEPOINT lf_billing_auto`.execute(trx);
+    return r;
+  } catch (e) {
+    if (!(e instanceof PostingError || e instanceof PeriodLockedError)) throw e;
+    await sql`ROLLBACK TO SAVEPOINT lf_billing_auto`.execute(trx);
+    await sql`RELEASE SAVEPOINT lf_billing_auto`.execute(trx);
+    return { outcome: 'draft', reason: e.code };
+  }
+}
+
+/** The write-back event with the invoice's final status (one per transaction, DL-0373). */
+async function writeBackEvent(
+  trx: Trx,
+  companyId: string,
+  src: { entity: SourceEntity; recordId: string },
+  accountId: string,
+  invoiceId: string,
+  deps: BillingDeps,
+): Promise<void> {
+  const doc = await getSalesInvoice(trx, invoiceId);
+  const posted = doc.status === 'posted';
+  const opportunity = src.entity === 'Opportunity' ? src.recordId : null;
+  const invoice: Record<string, unknown> = {
+    id: doc.id,
+    status: doc.status,
+    issueDate: doc.invoiceDate,
+    dueDate: doc.dueDate,
+    accountSfId: accountId,
+    ...(opportunity === null ? {} : { opportunitySfId: opportunity }),
+  };
+  if (posted) {
+    Object.assign(invoice, { number: doc.invoiceNo, total: doc.total, amountDue: doc.total });
+  }
+  const writeBack: Record<string, unknown> = { version: 1, invoices: [invoice] };
+  if (opportunity !== null) {
+    writeBack.opportunities = [
+      {
+        sfId: opportunity,
+        invoiceStatus: doc.status,
+        ...(posted ? { amountInvoiced: doc.total } : {}),
+      },
+    ];
+  }
+  await deps.outbox.enqueue(trx, {
+    companyId,
+    topic: posted ? INVOICE_STATUS_POSTED_TOPIC : INVOICE_DRAFTED_TOPIC,
+    aggregateType: SALES_INVOICE_AGGREGATE,
+    aggregateId: doc.id,
+    payload: { source: src, writeBack },
+  });
+}
+
+/**
+ * Evaluate one billing source after a change of it or of one of its lines. Never creates a
+ * second invoice for a source.
+ */
+export async function evaluateBillingSource(
+  trx: Trx,
+  companyId: string,
+  src: { entity: SourceEntity; recordId: string },
+  key: string,
+  deps: BillingDeps,
+): Promise<SourceResult> {
+  // The header row is the per-source lock (a line change arrives without it).
+  const header = await loadRecord(trx, companyId, src.entity, src.recordId, true);
+  const existing = await loadTrigger(trx, companyId, src.entity, src.recordId);
+  if (existing) {
+    if (existing.triggerKey !== key) {
+      await sql`
+        UPDATE app.salesforce_billing_trigger
+           SET later_events = later_events + 1, last_event_key = ${key}
+         WHERE id = ${existing.id}`.execute(trx);
+    }
+    return { status: 'already_drafted', invoiceId: existing.invoiceId };
+  }
+  const settings = await loadBillingSettings(trx, companyId);
+  if (TRIGGER_ENTITY[settings.triggerSource] !== src.entity) {
+    return { status: 'not_this_trigger', triggerSource: settings.triggerSource };
+  }
+  if (!header || header.state === 'deleted' || !isTriggered(src.entity, header.fields, settings)) {
+    await resolveIssues(trx, companyId, src, key);
+    return { status: 'not_triggered' };
+  }
+  const waiting = async (code: BlockingCode, message: string): Promise<SourceResult> => {
+    await raiseIssue(trx, companyId, src, code, message, header.fields, key);
+    return { status: 'waiting', code };
+  };
+
+  const { rows: lineRows } = await sql<{ record_id: string; fields: SfState }>`
+    SELECT record_id, fields FROM app.salesforce_billing_record
+     WHERE company_id = ${companyId} AND entity = ${LINE_OF[src.entity]}
+       AND parent_id = ${src.recordId} AND state = 'live'`.execute(trx);
+  const plan = planDraft(
+    src.entity,
+    header.fields,
+    lineRows.map((r) => ({ recordId: r.record_id, fields: r.fields })),
+  );
+  if (!plan.ok) return waiting(plan.code, plan.message);
+
+  const company = await trx
+    .selectFrom('app.company')
+    .select('base_currency')
+    .where('id', '=', companyId)
+    .executeTakeFirstOrThrow();
+  if (plan.currency !== null && plan.currency !== company.base_currency) {
+    return waiting(
+      'INVALID_SOURCE',
+      `${src.entity} currency ${plan.currency}: only the base currency ${company.base_currency} is invoiced today`,
+    );
+  }
+  const party = await trx
+    .selectFrom('app.party')
+    .select('id')
+    .where('company_id', '=', companyId)
+    .where('salesforce_account_id', '=', plan.accountId)
+    .executeTakeFirst();
+  if (!party) {
+    return waiting(
+      'UNKNOWN_ACCOUNT',
+      `Account ${plan.accountId} is not in LedgerForce (not synced yet, or rejected — see the inbound issues); the draft is created by the next change after it syncs`,
+    );
+  }
+  const sfProducts = [...new Set(plan.lines.map((l) => l.productId))];
+  const products = await trx
+    .selectFrom('app.product')
+    .select(['id', 'name', 'salesforce_product_id'])
+    .where('company_id', '=', companyId)
+    .where('salesforce_product_id', 'in', sfProducts)
+    .execute();
+  const bySf = new Map(products.map((p) => [p.salesforce_product_id, p]));
+  const missing = sfProducts.filter((p) => !bySf.has(p));
+  if (missing.length > 0) {
+    return waiting(
+      'UNKNOWN_PRODUCT',
+      `Product2 ${missing.join(', ')} not in LedgerForce (not synced yet, or rejected); the draft is created by the next change after it syncs`,
+    );
+  }
+
+  let date: { entryDate: string; note?: string };
+  try {
+    date = await resolvePostingDate(trx, {
+      companyId,
+      entryDate: plan.date,
+      sourceType: 'ar_invoice',
+    });
+  } catch (e) {
+    if (!(e instanceof PeriodLockedError)) throw e;
+    return waiting('PERIOD_LOCKED', e.message);
+  }
+
+  let created: { id: string };
+  try {
+    created = await createSalesInvoice(trx, {
+      input: {
+        companyId,
+        partyId: party.id,
+        invoiceDate: date.entryDate,
+        dueDate: addDays(date.entryDate, settings.paymentTermsDays),
+        amountsAre: 'exclusive',
+        ...(date.note === undefined ? {} : { memo: date.note }),
+        lines: plan.lines.map((l) => {
+          const p = bySf.get(l.productId);
+          const description = l.description ?? p?.name;
+          return {
+            productId: p?.id ?? '',
+            ...(description === undefined ? {} : { description }),
+            amount: l.amount,
+          };
+        }),
+      },
+      createdBy: null,
+      idempotencyKey: `sf:${src.entity}:${src.recordId}`,
+    });
+  } catch (e) {
+    if (!(e instanceof SalesInvoiceError)) throw e;
+    return waiting('INVOICE_REFUSED', e.message);
+  }
+
+  const warnings = await draftWarnings(
+    trx,
+    companyId,
+    party.id,
+    plan.lines.map((l) => bySf.get(l.productId)?.id ?? ''),
+  );
+  for (const skipped of plan.skipped) {
+    warnings.push({
+      code: 'ZERO_PRICE_LINE',
+      lineNo: null,
+      message: `line item ${skipped} has TotalPrice 0 and is not on the invoice`,
+      blocksAutoApprove: false,
+    });
+  }
+  const blocking = warnings.find((x) => x.blocksAutoApprove);
+  const auto =
+    blocking === undefined
+      ? await tryAutoApprove(trx, companyId, created.id, deps)
+      : ({ outcome: 'draft', reason: blocking.code } as const);
+
+  await writeBackEvent(trx, companyId, src, plan.accountId, created.id, deps);
+  await sql`
+    INSERT INTO app.salesforce_billing_trigger
+      (company_id, source_entity, record_id, account_id, invoice_id, trigger_key, source_date,
+       note, warnings, auto_approve, auto_reason)
+    VALUES (${companyId}, ${src.entity}, ${src.recordId}, ${plan.accountId}, ${created.id},
+            ${key}, ${plan.date}, ${date.note ?? null}, ${JSON.stringify(warnings)}::jsonb,
+            ${auto.outcome === 'posted' ? 'posted' : 'draft'},
+            ${auto.outcome === 'posted' ? null : auto.reason})`.execute(trx);
+  await resolveIssues(trx, companyId, src, key);
+  return { status: 'drafted', invoiceId: created.id, warnings, auto };
+}
+
+// --- entry points -------------------------------------------------------------------------------
+
+export async function applyBillingChange(
+  trx: Trx,
+  companyId: string,
+  change: BillingChange,
+  deps: BillingDeps,
+): Promise<BillingApplyResult> {
+  let recordId: string;
+  try {
+    recordId = toSalesforceId18(change.recordId);
+  } catch {
+    return { outcome: 'rejected', source: null };
+  }
+  const c: BillingChange = { ...change, recordId };
+  const prev = await loadRecord(trx, companyId, c.entity, recordId, true);
+  if (prev) {
+    const order = compareVersion(c.version, prev.version);
+    if (order !== 'newer') {
+      await countSkipped(trx, companyId, c, order === 'same' ? 'duplicate' : 'stale');
+      return { outcome: order === 'same' ? 'duplicate' : 'stale', source: null };
+    }
+  }
+  const fields =
+    c.op === 'delete' ? (prev?.fields ?? {}) : mergeState(prev?.fields ?? {}, c.fields);
+  const deleted = c.op === 'delete' || (c.op === 'upsert' && prev?.state === 'deleted');
+  const src = sourceOf(c.entity, recordId, fields);
+  const parentId = isLineEntity(c.entity) ? (src?.recordId ?? null) : null;
+  await saveRecord(trx, companyId, c, { parentId, state: deleted ? 'deleted' : 'live', fields });
+  if (src === null) return { outcome: 'applied', source: null };
+  // A line whose parent field changed also re-evaluates the source it left.
+  if (isLineEntity(c.entity) && prev?.parentId && prev.parentId !== parentId) {
+    await evaluateBillingSource(
+      trx,
+      companyId,
+      { entity: src.entity, recordId: prev.parentId },
+      c.key,
+      deps,
+    );
+  }
+  return {
+    outcome: 'applied',
+    source: await evaluateBillingSource(trx, companyId, src, c.key, deps),
+  };
+}
+
+/**
+ * The CDC subscriber handler (T-0064 `runSubscription`) for the Opportunity, OpportunityLineItem,
+ * Order and OrderItem channels of one company.
+ */
+export function salesforceBillingHandler(companyId: string, deps: BillingDeps): CdcHandler {
+  return async (trx, event, recordIds) => {
+    for (const change of billingChangesFromCdcEvent(event, recordIds)) {
+      await applyBillingChange(trx, companyId, change, deps);
+    }
+  };
+}
