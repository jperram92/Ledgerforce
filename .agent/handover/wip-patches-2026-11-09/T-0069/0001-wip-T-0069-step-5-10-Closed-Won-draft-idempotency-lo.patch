+/**
+ * Closed Won / Order activated → draft sales invoice (T-0069, UC-01; RQ-0124; migration 0044).
+ * Real PostgreSQL as lf_app. Account / Contact / Product2 reach LedgerForce through the T-0065
+ * inbound applier, Opportunity / OpportunityLineItem / Order / OrderItem through the billing
+ * applier, all built from the documented Avro fixtures exactly as production decodes them. The
+ * outbox is a recorder; its write-back payloads are checked through the T-0067 mapping. No org.
+ *
+ *  SS-UC01-01 Closed Won creates exactly one Draft from the Opportunity lines (PROFESSIONAL_SERVICES
+ *             and SUBSCRIPTION profiles, tax code GST); SS-UC01-02 backend half: the write-back
+ *             event sets Opportunity.LF_Invoice_Status__c = "Draft".
+ *  SS-UC01-04 Above the auto-approve threshold the draft stays Draft, no journal.
+ *  SS-UC01-06 A posting-profile gap leaves the draft with a PROFILE_GAP warning, nothing posts,
+ *             the gap check lists the combination (also TAX_CODE_CONFLICT).
+ *  SS-UC01-07 The same CDC event twice → one draft, the second logged as duplicate.
+ *  SS-UC01-08 Close date in a hard-locked October: "reject" → PERIOD_LOCKED billing issue, no
+ *             draft; "first open date" → invoice dated 2026-11-01 with the policy note.
+ */
+import { SfNumber } from '../writeback/batch.ts';
+import { mapToRecords, parseWriteBackPayload } from '../writeback/mapping.ts';
+import { getSalesInvoice, previewSalesInvoice, setInvoiceSettings } from '@ledgerforce/ar';
+import { DEFAULT_PERIOD_SETTINGS, setPeriodSettings } from '@ledgerforce/ledger';
+import { postingProfileGapCheck, resolvePartyProductPosting } from '@ledgerforce/products';
+import { sql } from 'kysely';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { billingCdc1, billingId, decodeBillingEvent, epochDay } from '../testing/billing-events.ts';
+import { nextCommit, startBillingWorld, type BillingWorld } from '../testing/billing-world.ts';
+import { sfId } from '../testing/master-data-events.ts';
+import {
+  getBillingRecord,
+  getBillingTrigger,
+  listBillingIssues,
+  salesforceBillingHandler,
+  setBillingSettings,
+} from './apply.ts';
+
+const T = '01900000-0000-7000-8000-000000006901';
+let w: BillingWorld;
+let PS: string;
+let SUB: string;
+let oppNo = 0;
+let lineNo = 0;
+
+const opp = () => billingId('006', (oppNo += 1));
+
+/** Two line items (services $1,000, subscription $250) on Opportunity `id`. */
+async function addLines(
+  id: string,
+  lines: { product: string; total: number; description?: string }[],
+): Promise<string[]> {
+  const ids: string[] = [];
+  for (const [i, l] of lines.entries()) {
+    const lineId = billingId('00k', (lineNo += 1));
+    ids.push(lineId);
+    await w.bill(
+      billingCdc1({
+        entity: 'OpportunityLineItem',
+        recordIds: [lineId],
+        changeType: 'CREATE',
+        commitNumber: nextCommit(),
+        fields: {
+          OpportunityId: id,
+          Product2Id: l.product,
+          Description: l.description ?? null,
+          Quantity: 1,
+          UnitPrice: l.total,
+          TotalPrice: l.total,
+          SortOrder: i + 1,
+        },
+      }),
+    );
+  }
+  return ids;
+}
+
+const createOpp = (id: string, account: string, closeDate: string, amount: number) =>
+  w.bill(
+    billingCdc1({
+      entity: 'Opportunity',
+      recordIds: [id],
+      changeType: 'CREATE',
+      commitNumber: nextCommit(),
+      fields: {
+        Name: `Deal ${id.slice(-6)}`,
+        AccountId: account,
+        StageName: 'Negotiation/Review',
+        IsClosed: false,
+        IsWon: false,
+        CloseDate: epochDay(closeDate),
+        Amount: amount,
+        CurrencyIsoCode: 'AUD',
+      },
+    }),
+  );
+
+const closedWonEvent = (id: string, commitNumber = nextCommit()) => ({
+  entity: 'Opportunity' as const,
+  recordIds: [id],
+  changeType: 'UPDATE' as const,
+  commitNumber,
+  fields: { StageName: 'Closed Won', IsClosed: true, IsWon: true },
+  changed: ['StageName', 'IsClosed', 'IsWon'],
+});
+const closeWon = (id: string) => w.bill(billingCdc1(closedWonEvent(id)));
+
+const invoicesOf = (sourceKey: string) =>
+  w.inTenant(async (trx) => {
+    const r = await sql<{ id: string; status: string }>`
+      SELECT id::text, status FROM app.sales_invoice
+       WHERE company_id = ${w.companyId} AND idempotency_key = ${sourceKey}`.execute(trx);
+    return r.rows;
+  });
+const autoApprove = (on: boolean, threshold: string) =>
+  w.inTenant((trx) =>
+    setInvoiceSettings(trx, {
+      companyId: w.companyId,
+      autoApprove: on,
+      threshold,
+      setBy: w.financeAdmin,
+      reason: `auto-approve ${String(on)} ≤ ${threshold}`,
+    }),
+  );
+const lockPolicy = (policy: 'reject' | 'post_to_first_open_date_with_note') =>
+  w.inTenant((trx) =>
+    setPeriodSettings(trx, {
+      settings: { ...DEFAULT_PERIOD_SETTINGS, lockDatePolicy: policy },
+      setBy: w.financeAdmin,
+      reason: `lock policy ${policy}`,
+    }),
+  );
+const profileCode = (id: string) =>
+  w.inTenant(async (trx) => {
+    const r = await sql<{ code: string | null }>`
+      SELECT pp.code FROM app.product p
+        LEFT JOIN app.product_posting_profile pp ON pp.id = p.product_posting_profile_id
+       WHERE p.id = ${id}`.execute(trx);
+    return r.rows[0]?.code ?? null;
+  });
+
+beforeAll(async () => {
+  w = await startBillingWorld(T);
+  PS = await w.product(1, 'Professional services', 'Professional Services', 'GST');
+  SUB = await w.product(2, 'Subscription', 'Subscription', 'GST');
+  await w.customer(1, { name: 'Acme Pty Ltd' });
+});
+
+afterAll(async () => {
+  await w?.close();
+});
+
+describe('SS-UC01-01: Closed Won creates a draft invoice from the template', () => {
+  it('an Opportunity with two line items moving to Closed Won → exactly one Draft with two mapped lines, tax code GST', async () => {
+    const id = opp();
+    const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+    await createOpp(id, account, '2026-11-05', 1250);
+    await addLines(id, [
+      { product: PS, total: 1000, description: 'Professional services' },
+      { product: SUB, total: 250, description: 'Subscription' },
+    ]);
+    expect(await invoicesOf(`sf:Opportunity:${id}`)).toEqual([]); // not won yet
+
+    const before = w.messages.length;
+    const r = await closeWon(id);
+    expect(r.outcome).toBe('applied');
+    expect(r.source).toMatchObject({ status: 'drafted', warnings: [] });
+
+    const invoices = await invoicesOf(`sf:Opportunity:${id}`);
+    expect(invoices).toHaveLength(1);
+    const invoiceId = invoices[0]?.id ?? '';
+    const doc = await w.inTenant((trx) => getSalesInvoice(trx, invoiceId));
+    expect(doc).toMatchObject({
+      status: 'draft',
+      invoiceDate: '2026-11-05',
+      dueDate: '2026-11-19', // payment terms default 14 days (RQ-0124 F6)
+      amountsAre: 'exclusive',
+      currency: 'AUD',
+      createdBy: null,
+      journalEntryId: null,
+    });
+    expect(doc.lines.map((l) => [l.amount, l.description, l.taxCode])).toEqual([
+      ['1000.0000', 'Professional services', null],
+      ['250.0000', 'Subscription', null],
+    ]);
+    expect(await Promise.all(doc.lines.map((l) => profileCode(l.productId)))).toEqual([
+      'PROFESSIONAL_SERVICES',
+      'SUBSCRIPTION',
+    ]);
+    const resolved = await w.inTenant((trx) =>
+      Promise.all(
+        doc.lines.map((l) =>
+          resolvePartyProductPosting(trx, {
+            companyId: w.companyId,
+            partyId: doc.partyId,
+            productId: l.productId,
+            direction: 'sale',
+            slot: 'revenue',
+          }),
+        ),
+      ),
+    );
+    expect(resolved.map((x) => x.taxCode)).toEqual(['GST', 'GST']);
+    const preview = await w.inTenant((trx) => previewSalesInvoice(trx, invoiceId));
+    expect([preview.netTotal, preview.taxTotal]).toEqual(['1250.0000', '125.0000']); // NUMERIC(19,4) text
+    expect(await w.countEntries()).toBe(0);
+
+    const trigger = await w.inTenant((trx) =>
+      getBillingTrigger(trx, w.companyId, 'Opportunity', id),
+    );
+    expect(trigger).toMatchObject({
+      invoiceId,
+      accountId: account,
+      sourceDate: '2026-11-05',
+      autoApprove: 'draft',
+      autoReason: 'AUTO_APPROVE_OFF',
+      warnings: [],
+      laterEvents: 0,
+    });
+
+    // SS-UC01-02 (backend half): one write-back event, Opportunity → "Draft", mirror upserted.
+    const sent = w.messages.slice(before);
+    expect(sent.map((m) => [m.topic, m.aggregateType, m.aggregateId])).toEqual([
+      ['invoice.drafted', 'sales_invoice', invoiceId],
+    ]);
+    const records = mapToRecords(parseWriteBackPayload(sent[0]?.payload));
+    expect(records).toEqual([
+      {
+        op: 'upsert',
+        sobject: 'LF_Invoice__c',
+        externalIdField: 'LF_Id__c',
+        key: invoiceId,
+        fields: {
+          LF_Status__c: 'Draft',
+          LF_Issue_Date__c: '2026-11-05',
+          LF_Due_Date__c: '2026-11-19',
+          LF_Account__c: account,
+          LF_Opportunity__c: id,
+        },
+      },
+      { op: 'update', sobject: 'Opportunity', key: id, fields: { LF_Invoice_Status__c: 'Draft' } },
+    ]);
+  });
+
+  it('the CDC handler takes the same path: decoded events, one draft', async () => {
+    const id = opp();
+    const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+    await createOpp(id, account, '2026-11-06', 250);
+    await addLines(id, [{ product: SUB, total: 250 }]);
+    const handler = salesforceBillingHandler(w.companyId, w.deps);
+    const event = decodeBillingEvent(closedWonEvent(id));
+    await w.inTenant((trx) => handler(trx, event, [id]));
+    expect(await invoicesOf(`sf:Opportunity:${id}`)).toHaveLength(1);
+  });
+});
