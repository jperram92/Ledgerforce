+describe('SS-UC01-07: Duplicate CDC event is idempotent', () => {
+  it('the same Closed Won event (same record Id + commit number) twice → one draft, the second logged as duplicate', async () => {
+    const id = opp();
+    const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+    await createOpp(id, account, '2026-11-05', 1250);
+    await addLines(id, [
+      { product: PS, total: 1000 },
+      { product: SUB, total: 250 },
+    ]);
+    const event = closedWonEvent(id);
+    const first = await w.bill(billingCdc1(event));
+    const second = await w.bill(billingCdc1(event));
+    expect(first.source).toMatchObject({ status: 'drafted' });
+    expect(second).toEqual({ outcome: 'duplicate', source: null });
+    expect(await invoicesOf(`sf:Opportunity:${id}`)).toHaveLength(1);
+    const rec = await w.inTenant((trx) => getBillingRecord(trx, w.companyId, 'Opportunity', id));
+    expect(rec).toMatchObject({
+      duplicates: 1,
+      lastSkippedKey: `cdc:Opportunity:${id}:${event.commitNumber.toString()}:1`,
+    });
+  });
+
+  it('a later, different event of a drafted Opportunity creates nothing and is counted on the trigger', async () => {
+    const id = opp();
+    const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+    await createOpp(id, account, '2026-11-05', 250);
+    await addLines(id, [{ product: SUB, total: 250 }]);
+    await closeWon(id);
+    const later = billingCdc1({
+      entity: 'Opportunity',
+      recordIds: [id],
+      changeType: 'UPDATE',
+      commitNumber: nextCommit(),
+      fields: { Name: 'Renamed deal' },
+      changed: ['Name'],
+    });
+    const r = await w.bill(later);
+    expect(r).toMatchObject({ outcome: 'applied', source: { status: 'already_drafted' } });
+    expect(await invoicesOf(`sf:Opportunity:${id}`)).toHaveLength(1);
+    const trigger = await w.inTenant((trx) =>
+      getBillingTrigger(trx, w.companyId, 'Opportunity', id),
+    );
+    expect(trigger).toMatchObject({ laterEvents: 1, lastEventKey: later.key });
+  });
+
+  it('lines that arrive after Closed Won (other channel) are waited for, then one draft', async () => {
+    const id = opp();
+    const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+    await createOpp(id, account, '2026-11-05', 1250);
+    await addLines(id, [{ product: PS, total: 1000 }]);
+    const r = await closeWon(id);
+    expect(r.source).toEqual({ status: 'waiting', code: 'LINES_INCOMPLETE' });
+    expect(await invoicesOf(`sf:Opportunity:${id}`)).toEqual([]);
+    const issues = await w.inTenant((trx) => listBillingIssues(trx, w.companyId));
+    expect(issues.filter((i) => i.recordId === id)).toMatchObject([
+      { code: 'LINES_INCOMPLETE', status: 'open', sourceEntity: 'Opportunity' },
+    ]);
+    await addLines(id, [{ product: SUB, total: 250 }]);
+    expect(await invoicesOf(`sf:Opportunity:${id}`)).toHaveLength(1);
+    const after = await w.inTenant((trx) => listBillingIssues(trx, w.companyId));
+    expect(after.filter((i) => i.recordId === id)).toMatchObject([
+      { code: 'LINES_INCOMPLETE', status: 'resolved' },
+    ]);
+  });
+
+  it('an Account LedgerForce does not know raises UNKNOWN_ACCOUNT and no draft', async () => {
+    const id = opp();
+    await createOpp(id, sfId('001', 9999), '2026-11-05', 250);
+    await addLines(id, [{ product: SUB, total: 250 }]);
+    const r = await closeWon(id);
+    expect(r.source).toMatchObject({ status: 'waiting', code: 'UNKNOWN_ACCOUNT' });
+    expect(await invoicesOf(`sf:Opportunity:${id}`)).toEqual([]);
+  });
+});
