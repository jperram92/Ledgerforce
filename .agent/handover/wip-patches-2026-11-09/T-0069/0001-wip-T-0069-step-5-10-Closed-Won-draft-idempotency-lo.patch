+describe('SS-UC01-08: Closed Won dated in a hard-locked period follows lock policy', () => {
+  it('October hard-locked, closed 2026-10-30: "reject" → PERIOD_LOCKED sync issue, no draft; "first open date" → invoice dated 2026-11-01 with a note', async () => {
+    await w.lockMonth('2026-10', 'hard_locked');
+    await lockPolicy('reject');
+    try {
+      const id = opp();
+      const account = await w.customer(1, { name: 'Acme Pty Ltd' });
+      await createOpp(id, account, '2026-10-30', 250);
+      await addLines(id, [{ product: SUB, total: 250 }]);
+      const rejected = await closeWon(id);
+      expect(rejected.source).toEqual({ status: 'waiting', code: 'PERIOD_LOCKED' });
+      expect(await invoicesOf(`sf:Opportunity:${id}`)).toEqual([]);
+      const issues = await w.inTenant((trx) => listBillingIssues(trx, w.companyId));
+      const mine = issues.filter((i) => i.recordId === id);
+      expect(mine).toMatchObject([{ code: 'PERIOD_LOCKED', status: 'open', occurrences: 1 }]);
+      expect(mine[0]?.message).toMatch(/PERIOD_LOCKED: period 2026-10 is hard_locked/);
+
+      await lockPolicy('post_to_first_open_date_with_note');
+      // The next change of the Opportunity re-evaluates it under the new policy.
+      const retry = await w.bill(
+        billingCdc1({
+          entity: 'Opportunity',
+          recordIds: [id],
+          changeType: 'UPDATE',
+          commitNumber: nextCommit(),
+          fields: { Name: 'Deal (retry)' },
+          changed: ['Name'],
+        }),
+      );
+      expect(retry.source).toMatchObject({ status: 'drafted' });
+      const [inv] = await invoicesOf(`sf:Opportunity:${id}`);
+      const doc = await w.inTenant((trx) => getSalesInvoice(trx, inv?.id ?? ''));
+      expect(doc.invoiceDate).toBe('2026-11-01');
+      expect(doc.dueDate).toBe('2026-11-15');
+      expect(doc.memo).toMatch(
+        /^Dated 2026-10-30 in period 2026-10 \(hard_locked\); posted on the first open date 2026-11-01/,
+      );
+      const trigger = await w.inTenant((trx) =>
+        getBillingTrigger(trx, w.companyId, 'Opportunity', id),
+      );
+      expect(trigger).toMatchObject({ sourceDate: '2026-10-30', note: doc.memo });
+      const after = await w.inTenant((trx) => listBillingIssues(trx, w.companyId));
+      expect(after.filter((i) => i.recordId === id)).toMatchObject([
+        { code: 'PERIOD_LOCKED', status: 'resolved' },
+      ]);
+    } finally {
+      await lockPolicy('reject');
+    }
+  });
+});
