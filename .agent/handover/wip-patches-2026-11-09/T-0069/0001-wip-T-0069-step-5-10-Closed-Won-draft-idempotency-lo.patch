diff --git a/packages/connectors/salesforce/src/testing/billing-events.ts b/packages/connectors/salesforce/src/testing/billing-events.ts
new file mode 100644
index 0000000..de3a261
--- /dev/null
+++ b/packages/connectors/salesforce/src/testing/billing-events.ts
@@ -0,0 +1,102 @@
+/**
+ * Test-only: Avro-encoded Opportunity / OpportunityLineItem / Order / OrderItem change events with
+ * the documented fixture schemas (RQ-0124; fixtures/documented/pubsub-billing-source-change-events
+ * .json), decoded and turned into changes the way production does (Avro encode → decode →
+ * billingChangesFromCdcEvent). Not used in production.
+ */
+import { readFileSync } from 'node:fs';
+import { toSalesforceId18 } from '@ledgerforce/parties';
+import { billingChangesFromCdcEvent, type BillingChange } from '../billing/source.ts';
+import {
+  decodeConsumerEvent,
+  parseEventSchema,
+  type ChangeType,
+  type DecodedEvent,
+  type EventSchema,
+} from '../pubsub/avro.ts';
+import { bitmaps } from './master-data-events.ts';
+
+export type BillingEventEntity = 'Opportunity' | 'OpportunityLineItem' | 'Order' | 'OrderItem';
+
+const fixture = JSON.parse(
+  readFileSync(
+    new URL('../../fixtures/documented/pubsub-billing-source-change-events.json', import.meta.url),
+    'utf8',
+  ),
+) as { schemas: Record<BillingEventEntity, { topic: string; schemaId: string; schema: unknown }> };
+
+export const billingSchemaJson = (e: BillingEventEntity): string =>
+  JSON.stringify(fixture.schemas[e].schema);
+
+const schemas = new Map<BillingEventEntity, EventSchema>(
+  (['Opportunity', 'OpportunityLineItem', 'Order', 'OrderItem'] as const).map((e) => [
+    e,
+    parseEventSchema(billingSchemaJson(e)),
+  ]),
+);
+
+/** A valid 18-character test Id for a billing record: 006 Opportunity, 00k line, 801 Order, 802 item. */
+export function billingId(prefix: '006' | '00k' | '801' | '802', n: number): string {
+  return toSalesforceId18(`${prefix}TEST${String(n).padStart(8, '0')}`);
+}
+
+/** Days since 1970-01-01 of a YYYY-MM-DD date (the Avro `date` int). */
+export const epochDay = (date: string): number =>
+  Math.round(Date.parse(`${date}T00:00:00Z`) / 86_400_000);
+
+export interface BillingEvent {
+  entity: BillingEventEntity;
+  recordIds: string[];
+  changeType: ChangeType;
+  commitNumber: bigint;
+  sequenceNumber?: number;
+  fields?: Record<string, unknown>;
+  changed?: string[];
+  nulled?: string[];
+}
+
+export function encodeBillingChange(c: BillingEvent): Buffer {
+  const schema = schemas.get(c.entity);
+  if (!schema) throw new TypeError(`no schema for ${c.entity}`);
+  const value: Record<string, unknown> = {
+    ChangeEventHeader: {
+      entityName: c.entity,
+      recordIds: c.recordIds,
+      changeType: c.changeType,
+      changeOrigin: 'com/salesforce/api/rest/62.0',
+      transactionKey: `tx-${c.commitNumber.toString()}`,
+      sequenceNumber: c.sequenceNumber ?? 1,
+      commitTimestamp: 1_761_350_000_000n + c.commitNumber,
+      commitNumber: c.commitNumber,
+      commitUser: '005TEST00000001AAA',
+      nulledFields: c.nulled && c.nulled.length > 0 ? bitmaps(schema, c.nulled) : [],
+      diffFields: [],
+      changedFields: c.changed && c.changed.length > 0 ? bitmaps(schema, c.changed) : [],
+    },
+  };
+  for (const name of schema.fieldNames) {
+    if (name === 'ChangeEventHeader') continue;
+    value[name] = c.fields?.[name] ?? null;
+  }
+  return schema.type.toBuffer(value);
+}
+
+/** The decoded event the subscriber would hand to a CDC handler. */
+export function decodeBillingEvent(c: BillingEvent): DecodedEvent {
+  return decodeConsumerEvent(parseEventSchema(billingSchemaJson(c.entity)), {
+    replayId: Buffer.from('0000000000000001', 'hex'),
+    event: { id: crypto.randomUUID(), schemaId: 'x', payload: encodeBillingChange(c) },
+  });
+}
+
+/** The changes production builds from this event (all of its records). */
+export function billingCdc(c: BillingEvent): BillingChange[] {
+  const e = decodeBillingEvent(c);
+  return billingChangesFromCdcEvent(e, e.header?.recordIds ?? []);
+}
+
+export function billingCdc1(c: BillingEvent): BillingChange {
+  const [one] = billingCdc(c);
+  if (!one) throw new Error('event produced no change');
+  return one;
+}
diff --git a/packages/connectors/salesforce/src/testing/billing-world.ts b/packages/connectors/salesforce/src/testing/billing-world.ts
new file mode 100644
index 0000000..8628947
--- /dev/null
+++ b/packages/connectors/salesforce/src/testing/billing-world.ts
@@ -0,0 +1,156 @@
+/**
+ * Test-only world for the Closed Won db tests (T-0069): the T-0065 inbound world (AU chart, AU tax
+ * codes, AU services posting profiles with their Salesforce mapping) plus an AU fiscal year
+ * 2026/27, the invoice and journal number series and a Finance Admin. Master data reaches
+ * LedgerForce the production way — Account / Contact / Product2 change events through
+ * applyInboundChange — and billing events through applyBillingChange with a recording outbox.
+ * Not used in production.
+ */
+import type { Database } from '@ledgerforce/db';
+import type { OutboxMessage } from '@ledgerforce/outbox';
+import {
+  generateFiscalYear,
+  findPeriod,
+  setPeriodStatus,
+  type PeriodStatus,
+} from '@ledgerforce/ledger';
+import { randomUUID } from 'node:crypto';
+import { sql, type Transaction } from 'kysely';
+import { applyBillingChange, type BillingApplyResult, type BillingDeps } from '../billing/apply.ts';
+import type { BillingChange } from '../billing/source.ts';
+import { cdc1, startInboundWorld, type InboundWorld } from './inbound-world.ts';
+import { sfId } from './master-data-events.ts';
+
+type Trx = Transaction<Database>;
+
+export interface RecordedMessage extends OutboxMessage {
+  /** The event id the recording outbox gave it. */
+  id: string;
+}
+
+export interface BillingWorld extends InboundWorld {
+  financeAdmin: string;
+  /** Every outbox message the billing trigger wrote, in order. */
+  messages: RecordedMessage[];
+  deps: BillingDeps;
+  bill: (c: BillingChange, deps?: BillingDeps) => Promise<BillingApplyResult>;
+  /** A synced customer Account (Type Customer - Direct) with a Billing To Contact. */
+  customer: (n: number, opts?: { billingTo?: boolean; name?: string }) => Promise<string>;
+  /** A synced Product2 with a Family (and optional LF_Tax_Code__c). */
+  product: (n: number, name: string, family: string, taxCode?: string) => Promise<string>;
+  lockMonth: (month: string, status: PeriodStatus) => Promise<void>;
+  countEntries: () => Promise<number>;
+}
+
+let commit = 900_000n;
+/** A commit number above every other event of the world (master data and billing share it). */
+export const nextCommit = (): bigint => (commit += 1n);
+
+export async function startBillingWorld(tenantId: string): Promise<BillingWorld> {
+  const w = await startInboundWorld(tenantId);
+  const financeAdmin = await w.inTenant(async (trx) => {
+    await generateFiscalYear(trx, { companyId: w.companyId, convention: 'AU', startYear: 2026 });
+    await sql`
+      INSERT INTO app.number_series (company_id, code, prefix)
+      VALUES (${w.companyId}, 'ar_invoice', 'INV-'), (${w.companyId}, 'je_ar_invoice', 'ARJ-')
+      ON CONFLICT DO NOTHING`.execute(trx);
+    const user = await trx
+      .insertInto('app.app_user')
+      .values({
+        email: `finance-${randomUUID().slice(0, 8)}@example.test`,
+        display_name: 'Finance Admin',
+        status: 'active',
+      })
+      .returning('id')
+      .executeTakeFirstOrThrow();
+    await trx
+      .insertInto('app.user_role')
+      .values({ user_id: user.id, role: 'finance_admin' })
+      .execute();
+    return user.id;
+  });
+  const messages: RecordedMessage[] = [];
+  const deps: BillingDeps = {
+    outbox: {
+      enqueue: async (_trx: Trx, msg: OutboxMessage) => {
+        const id = randomUUID();
+        messages.push({ ...msg, id });
+        return id;
+      },
+    },
+  };
+  const bill = (c: BillingChange, d: BillingDeps = deps) =>
+    w.inTenant((trx) => applyBillingChange(trx, w.companyId, c, d));
+
+  async function customer(n: number, opts: { billingTo?: boolean; name?: string } = {}) {
+    const accountId = sfId('001', n);
+    await w.apply(
+      cdc1({
+        entity: 'Account',
+        recordIds: [accountId],
+        changeType: 'CREATE',
+        commitNumber: nextCommit(),
+        fields: {
+          Name: opts.name ?? `Customer ${String(n)} Pty Ltd`,
+          Type: 'Customer - Direct',
+          CurrencyIsoCode: 'AUD',
+        },
+      }),
+    );
+    if (opts.billingTo !== false) {
+      await w.apply(
+        cdc1({
+          entity: 'Contact',
+          recordIds: [sfId('003', n)],
+          changeType: 'CREATE',
+          commitNumber: nextCommit(),
+          fields: {
+            AccountId: accountId,
+            Name: { FirstName: 'Accounts', LastName: `Payable ${String(n)}` },
+            Email: `accounts${String(n)}@customer.example`,
+            LF_Billing_Role__c: 'Billing To',
+          },
+        }),
+      );
+    }
+    return accountId;
+  }
+
+  async function product(n: number, name: string, family: string, taxCode?: string) {
+    const productId = sfId('01t', n);
+    await w.apply(
+      cdc1({
+        entity: 'Product2',
+        recordIds: [productId],
+        changeType: 'CREATE',
+        commitNumber: nextCommit(),
+        fields: {
+          Name: name,
+          ProductCode: `P${String(n)}`,
+          Family: family,
+          IsActive: true,
+          ...(taxCode === undefined ? {} : { LF_Tax_Code__c: taxCode }),
+        },
+      }),
+    );
+    return productId;
+  }
+
+  const lockMonth = (month: string, status: PeriodStatus) =>
+    w.inTenant(async (trx) => {
+      const period = await findPeriod(trx, w.companyId, `${month}-15`);
+      if (!period) throw new Error(`no period ${month}`);
+      await setPeriodStatus(trx, { periodId: period.id, status, actorId: financeAdmin });
+    });
+
+  const countEntries = () =>
+    w.inTenant(async (trx) => {
+      const r = await sql<{ n: number }>`
+        SELECT count(*)::int AS n FROM app.journal_entry WHERE company_id = ${w.companyId}`.execute(
+        trx,
+      );
+      return r.rows[0]?.n ?? -1;
+    });
+
+  return { ...w, financeAdmin, messages, deps, bill, customer, product, lockMonth, countEntries };
+}
