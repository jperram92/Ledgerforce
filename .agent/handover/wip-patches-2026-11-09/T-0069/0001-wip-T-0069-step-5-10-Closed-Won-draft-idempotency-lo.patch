diff --git a/packages/db/migrations/0044_salesforce_billing_trigger.sql b/packages/db/migrations/0044_salesforce_billing_trigger.sql
new file mode 100644
index 0000000..a8d6039
--- /dev/null
+++ b/packages/db/migrations/0044_salesforce_billing_trigger.sql
@@ -0,0 +1,245 @@
+-- 0044 — Salesforce billing trigger: Closed Won Opportunity / activated Order → one draft sales
+-- invoice (T-0069, UC-01, design §4.3, §5.3, §5.5, §5.6 rules 1, 2, 5; RQ-0124; DL-0370..DL-0375).
+-- Owner: packages/connectors/salesforce (src/billing).
+--
+-- * app.salesforce_billing_record: last known Salesforce state and version of every billing-source
+--   record (Opportunity, OpportunityLineItem, Order, OrderItem), as app.salesforce_record_sync
+--   (0034) does for master data; 0034's entity CHECK cannot be widened (the runner refuses DROP
+--   CONSTRAINT), so billing sources get this sibling table. parent_id is the line's
+--   OpportunityId / OrderId (null for a header). Same version = duplicate, older = stale; both
+--   are counted with the key, never applied (design §5.6 rule 1).
+-- * app.salesforce_billing_trigger: at most one row per (company, source entity, source record
+--   Id), written in the same transaction as the draft invoice it links. It is the per-source
+--   idempotency record (a repeat or later event only bumps later_events), and it carries the
+--   draft-time warnings (PROFILE_GAP, TAX_CODE_CONFLICT, …), the lock-date note and the
+--   auto-approve outcome. The invoice link never changes once written.
+-- * app.salesforce_billing_issue: why a won/activated source has no draft yet (PERIOD_LOCKED under
+--   policy reject, NO_LINES, LINES_INCOMPLETE, UNKNOWN_ACCOUNT, UNKNOWN_PRODUCT, INVALID_SOURCE,
+--   INVOICE_REFUSED) — the billing side of the Sync issues inbox, same status words as 0034. One
+--   live issue per (source, code); a repeat bumps occurrences; drafting resolves them.
+-- * app.salesforce_billing_settings: the invoice trigger per company as an insert-only history
+--   (latest row wins): trigger_source (opportunity | order; design §11.2 is open, default
+--   opportunity), won stage names, payment terms in days.
+-- * All tenant-owned: RLS ENABLE + FORCE, tenant_isolation, explicit lf_app grants, no DELETE.
+
+CREATE TABLE app.salesforce_billing_record (
+  tenant_id         uuid        NOT NULL DEFAULT nullif(current_setting('app.tenant_id', true), '')::uuid
+                                REFERENCES app.tenant (id),
+  company_id        uuid        NOT NULL,
+  entity            text        NOT NULL
+                                CHECK (entity IN ('Opportunity', 'OpportunityLineItem', 'Order', 'OrderItem')),
+  record_id         text        NOT NULL CHECK (record_id ~ '^[A-Za-z0-9]{18}$'),
+  parent_id         text        CHECK (parent_id ~ '^[A-Za-z0-9]{18}$'),
+  state             text        NOT NULL CHECK (state IN ('live', 'deleted')),
+  fields            jsonb       NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(fields) = 'object'),
+  commit_number     bigint,
+  sequence_number   integer     NOT NULL DEFAULT 0 CHECK (sequence_number >= 0),
+  commit_at         timestamptz NOT NULL,
+  last_key          text        NOT NULL CHECK (last_key ~ '^(cdc|poll):[[:graph:]]+$' AND length(last_key) <= 300),
+  duplicates        integer     NOT NULL DEFAULT 0 CHECK (duplicates >= 0),
+  stale             integer     NOT NULL DEFAULT 0 CHECK (stale >= 0),
+  last_skipped_key  text        CHECK (length(last_skipped_key) <= 300),
+  last_skipped_at   timestamptz,
+  created_at        timestamptz NOT NULL DEFAULT clock_timestamp(),
+  updated_at        timestamptz NOT NULL DEFAULT clock_timestamp(),
+  PRIMARY KEY (tenant_id, company_id, entity, record_id),
+  FOREIGN KEY (tenant_id, company_id) REFERENCES app.company (tenant_id, id),
+  CONSTRAINT salesforce_billing_record_parent
+    CHECK ((entity IN ('OpportunityLineItem', 'OrderItem')) OR parent_id IS NULL)
+);
+COMMENT ON TABLE app.salesforce_billing_record IS
+  'Inbound Salesforce billing-source state and version per record (Opportunity, OpportunityLineItem, Order, OrderItem; design 5.6 rule 1). Never deleted.';
+CREATE INDEX salesforce_billing_record_parent_idx
+  ON app.salesforce_billing_record (tenant_id, company_id, entity, parent_id)
+  WHERE parent_id IS NOT NULL;
+
+CREATE FUNCTION app.salesforce_billing_record_guard() RETURNS trigger
+  LANGUAGE plpgsql
+AS $$
+BEGIN
+  IF (NEW.tenant_id, NEW.company_id, NEW.entity, NEW.record_id, NEW.created_at)
+     IS DISTINCT FROM (OLD.tenant_id, OLD.company_id, OLD.entity, OLD.record_id, OLD.created_at) THEN
+    RAISE EXCEPTION 'salesforce billing record %/%: identity columns never change', OLD.entity, OLD.record_id
+      USING ERRCODE = 'check_violation';
+  END IF;
+  IF NEW.duplicates < OLD.duplicates OR NEW.stale < OLD.stale THEN
+    RAISE EXCEPTION 'salesforce billing record %/%: counters never decrease', OLD.entity, OLD.record_id
+      USING ERRCODE = 'check_violation';
+  END IF;
+  NEW.updated_at := clock_timestamp();
+  RETURN NEW;
+END
+$$;
+CREATE TRIGGER salesforce_billing_record_guard BEFORE UPDATE ON app.salesforce_billing_record
+  FOR EACH ROW EXECUTE FUNCTION app.salesforce_billing_record_guard();
+CREATE TRIGGER salesforce_billing_record_never_deleted BEFORE DELETE ON app.salesforce_billing_record
+  FOR EACH ROW EXECUTE FUNCTION app.sod_never_changed();
+
+ALTER TABLE app.salesforce_billing_record ENABLE ROW LEVEL SECURITY;
+ALTER TABLE app.salesforce_billing_record FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON app.salesforce_billing_record
+  USING (tenant_id = nullif(current_setting('app.tenant_id', true), '')::uuid)
+  WITH CHECK (tenant_id = nullif(current_setting('app.tenant_id', true), '')::uuid);
+GRANT SELECT, INSERT ON app.salesforce_billing_record TO lf_app;
+GRANT UPDATE (parent_id, state, fields, commit_number, sequence_number, commit_at, last_key,
+              duplicates, stale, last_skipped_key, last_skipped_at, updated_at)
+  ON app.salesforce_billing_record TO lf_app;
+
+CREATE TABLE app.salesforce_billing_trigger (
+  id                uuid        PRIMARY KEY DEFAULT app.uuid_generate_v7(),
+  tenant_id         uuid        NOT NULL DEFAULT nullif(current_setting('app.tenant_id', true), '')::uuid
+                                REFERENCES app.tenant (id),
+  company_id        uuid        NOT NULL,
+  source_entity     text        NOT NULL CHECK (source_entity IN ('Opportunity', 'Order')),
+  record_id         text        NOT NULL CHECK (record_id ~ '^[A-Za-z0-9]{18}$'),
+  account_id        text        NOT NULL CHECK (account_id ~ '^[A-Za-z0-9]{18}$'),
+  invoice_id        uuid        NOT NULL,
+  trigger_key       text        NOT NULL CHECK (trigger_key ~ '^(cdc|poll):[[:graph:]]+$' AND length(trigger_key) <= 300),
+  source_date       date        NOT NULL,
+  note              text        CHECK (length(note) <= 1000),
+  warnings          jsonb       NOT NULL DEFAULT '[]'::jsonb CHECK (jsonb_typeof(warnings) = 'array'),
+  auto_approve      text        NOT NULL CHECK (auto_approve IN ('posted', 'draft')),
+  auto_reason       text        CHECK (auto_reason ~ '^[A-Z][A-Z0-9_]{1,59}$'),
+  later_events      integer     NOT NULL DEFAULT 0 CHECK (later_events >= 0),
+  last_event_key    text        CHECK (length(last_event_key) <= 300),
+  created_at        timestamptz NOT NULL DEFAULT clock_timestamp(),
+  updated_at        timestamptz NOT NULL DEFAULT clock_timestamp(),
+  UNIQUE (tenant_id, id),
+  UNIQUE (tenant_id, company_id, source_entity, record_id),
+  UNIQUE (tenant_id, invoice_id),
+  FOREIGN KEY (tenant_id, company_id) REFERENCES app.company (tenant_id, id),
+  FOREIGN KEY (tenant_id, company_id, invoice_id) REFERENCES app.sales_invoice (tenant_id, company_id, id),
+  CONSTRAINT salesforce_billing_trigger_reason CHECK ((auto_approve = 'draft') = (auto_reason IS NOT NULL))
+);
+COMMENT ON TABLE app.salesforce_billing_trigger IS
+  'One draft sales invoice per Salesforce billing source (Closed Won Opportunity or activated Order; UC-01, design 5.6 rule 1): link, draft-time warnings, lock-date note, auto-approve outcome. Never deleted.';
+
+CREATE FUNCTION app.salesforce_billing_trigger_guard() RETURNS trigger
+  LANGUAGE plpgsql
+AS $$
+BEGIN
+  IF (NEW.id, NEW.tenant_id, NEW.company_id, NEW.source_entity, NEW.record_id, NEW.account_id,
+      NEW.invoice_id, NEW.trigger_key, NEW.source_date, NEW.note, NEW.warnings, NEW.created_at)
+     IS DISTINCT FROM
+     (OLD.id, OLD.tenant_id, OLD.company_id, OLD.source_entity, OLD.record_id, OLD.account_id,
+      OLD.invoice_id, OLD.trigger_key, OLD.source_date, OLD.note, OLD.warnings, OLD.created_at) THEN
+    RAISE EXCEPTION 'salesforce billing trigger %: the source, its invoice and the draft facts never change', OLD.id
+      USING ERRCODE = 'check_violation';
+  END IF;
+  IF NEW.later_events < OLD.later_events THEN
+    RAISE EXCEPTION 'salesforce billing trigger %: later_events never decreases', OLD.id
+      USING ERRCODE = 'check_violation';
+  END IF;
+  NEW.updated_at := clock_timestamp();
+  RETURN NEW;
+END
+$$;
+CREATE TRIGGER salesforce_billing_trigger_guard BEFORE UPDATE ON app.salesforce_billing_trigger
+  FOR EACH ROW EXECUTE FUNCTION app.salesforce_billing_trigger_guard();
+CREATE TRIGGER salesforce_billing_trigger_never_deleted BEFORE DELETE ON app.salesforce_billing_trigger
+  FOR EACH ROW EXECUTE FUNCTION app.sod_never_changed();
+
+ALTER TABLE app.salesforce_billing_trigger ENABLE ROW LEVEL SECURITY;
+ALTER TABLE app.salesforce_billing_trigger FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON app.salesforce_billing_trigger
+  USING (tenant_id = nullif(current_setting('app.tenant_id', true), '')::uuid)
+  WITH CHECK (tenant_id = nullif(current_setting('app.tenant_id', true), '')::uuid);
+GRANT SELECT, INSERT ON app.salesforce_billing_trigger TO lf_app;
+GRANT UPDATE (auto_approve, auto_reason, later_events, last_event_key, updated_at)
+  ON app.salesforce_billing_trigger TO lf_app;
+
+CREATE TABLE app.salesforce_billing_issue (
+  id                 uuid        PRIMARY KEY DEFAULT app.uuid_generate_v7(),
+  tenant_id          uuid        NOT NULL DEFAULT nullif(current_setting('app.tenant_id', true), '')::uuid
+                                 REFERENCES app.tenant (id),
+  company_id         uuid        NOT NULL,
+  source_entity      text        NOT NULL CHECK (source_entity IN ('Opportunity', 'Order')),
+  record_id          text        NOT NULL CHECK (record_id ~ '^[A-Za-z0-9]{18}$'),
+  code               text        NOT NULL
+                                 CHECK (code IN ('PERIOD_LOCKED', 'NO_LINES', 'LINES_INCOMPLETE', 'UNKNOWN_ACCOUNT',
+                                                 'UNKNOWN_PRODUCT', 'INVALID_SOURCE', 'INVOICE_REFUSED')),
+  message            text        NOT NULL CHECK (length(message) BETWEEN 1 AND 1000),
+  payload            jsonb       NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(payload) = 'object'),
+  last_key           text        NOT NULL CHECK (last_key ~ '^(cdc|poll):[[:graph:]]+$' AND length(last_key) <= 300),
+  status             text        NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'resolved', 'ignored')),
+  occurrences        integer     NOT NULL DEFAULT 1 CHECK (occurrences >= 1),
+  note               text        CHECK (length(note) <= 500),
+  status_changed_by  uuid,
+  first_seen_at      timestamptz NOT NULL DEFAULT clock_timestamp(),
+  last_seen_at       timestamptz NOT NULL DEFAULT clock_timestamp(),
+  resolved_at        timestamptz,
+  UNIQUE (tenant_id, id),
+  FOREIGN KEY (tenant_id, company_id) REFERENCES app.company (tenant_id, id),
+  FOREIGN KEY (tenant_id, status_changed_by) REFERENCES app.app_user (tenant_id, id),
+  CONSTRAINT salesforce_billing_issue_resolved_at CHECK ((status = 'resolved') = (resolved_at IS NOT NULL))
+);
+COMMENT ON TABLE app.salesforce_billing_issue IS
+  'Why a Closed Won Opportunity / activated Order has no draft invoice yet (Sync issues inbox, design 5.6 rules 2 and 5). Never silently dropped, never deleted.';
+CREATE UNIQUE INDEX salesforce_billing_issue_live_idx
+  ON app.salesforce_billing_issue (tenant_id, company_id, source_entity, record_id, code)
+  WHERE status IN ('open', 'ignored');
+CREATE INDEX salesforce_billing_issue_status_idx
+  ON app.salesforce_billing_issue (tenant_id, company_id, status, last_seen_at DESC);
+
+CREATE FUNCTION app.salesforce_billing_issue_guard() RETURNS trigger
+  LANGUAGE plpgsql
+AS $$
+BEGIN
+  IF (NEW.id, NEW.tenant_id, NEW.company_id, NEW.source_entity, NEW.record_id, NEW.code, NEW.first_seen_at)
+     IS DISTINCT FROM
+     (OLD.id, OLD.tenant_id, OLD.company_id, OLD.source_entity, OLD.record_id, OLD.code, OLD.first_seen_at) THEN
+    RAISE EXCEPTION 'billing issue %: identity columns never change', OLD.id USING ERRCODE = 'check_violation';
+  END IF;
+  IF NEW.occurrences < OLD.occurrences THEN
+    RAISE EXCEPTION 'billing issue %: occurrences never decrease', OLD.id USING ERRCODE = 'check_violation';
+  END IF;
+  IF OLD.status = 'resolved' THEN
+    RAISE EXCEPTION 'billing issue %: a resolved issue never changes (a new problem is a new issue)', OLD.id
+      USING ERRCODE = 'check_violation';
+  END IF;
+  RETURN NEW;
+END
+$$;
+CREATE TRIGGER salesforce_billing_issue_guard BEFORE UPDATE ON app.salesforce_billing_issue
+  FOR EACH ROW EXECUTE FUNCTION app.salesforce_billing_issue_guard();
+CREATE TRIGGER salesforce_billing_issue_never_deleted BEFORE DELETE ON app.salesforce_billing_issue
+  FOR EACH ROW EXECUTE FUNCTION app.sod_never_changed();
+
+ALTER TABLE app.salesforce_billing_issue ENABLE ROW LEVEL SECURITY;
+ALTER TABLE app.salesforce_billing_issue FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON app.salesforce_billing_issue
+  USING (tenant_id = nullif(current_setting('app.tenant_id', true), '')::uuid)
+  WITH CHECK (tenant_id = nullif(current_setting('app.tenant_id', true), '')::uuid);
+GRANT SELECT, INSERT ON app.salesforce_billing_issue TO lf_app;
+GRANT UPDATE (message, payload, last_key, status, occurrences, note, status_changed_by,
+              last_seen_at, resolved_at)
+  ON app.salesforce_billing_issue TO lf_app;
+
+CREATE TABLE app.salesforce_billing_settings (
+  id                  uuid        PRIMARY KEY DEFAULT app.uuid_generate_v7(),
+  tenant_id           uuid        NOT NULL DEFAULT nullif(current_setting('app.tenant_id', true), '')::uuid
+                                  REFERENCES app.tenant (id),
+  company_id          uuid        NOT NULL,
+  trigger_source      text        NOT NULL DEFAULT 'opportunity' CHECK (trigger_source IN ('opportunity', 'order')),
+  won_stages          text[]      NOT NULL DEFAULT ARRAY['Closed Won']::text[]
+                                  CHECK (cardinality(won_stages) BETWEEN 1 AND 20),
+  payment_terms_days  integer     NOT NULL DEFAULT 14 CHECK (payment_terms_days BETWEEN 0 AND 365),
+  set_by              uuid        NOT NULL,
+  reason              text        NOT NULL CHECK (length(btrim(reason)) BETWEEN 1 AND 2000),
+  set_at              timestamptz NOT NULL DEFAULT clock_timestamp(),
+  FOREIGN KEY (tenant_id, company_id) REFERENCES app.company (tenant_id, id),
+  FOREIGN KEY (tenant_id, set_by) REFERENCES app.app_user (tenant_id, id)
+);
+COMMENT ON TABLE app.salesforce_billing_settings IS
+  'Invoice trigger per company as history; the latest row wins (design 4.3, 11.2 open: default opportunity). Insert-only.';
+CREATE INDEX salesforce_billing_settings_latest_idx
+  ON app.salesforce_billing_settings (tenant_id, company_id, set_at DESC, id DESC);
+CREATE TRIGGER salesforce_billing_settings_immutable BEFORE UPDATE OR DELETE ON app.salesforce_billing_settings
+  FOR EACH ROW EXECUTE FUNCTION app.sod_never_changed();
+
+ALTER TABLE app.salesforce_billing_settings ENABLE ROW LEVEL SECURITY;
+ALTER TABLE app.salesforce_billing_settings FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON app.salesforce_billing_settings
+  USING (tenant_id = nullif(current_setting('app.tenant_id', true), '')::uuid)
+  WITH CHECK (tenant_id = nullif(current_setting('app.tenant_id', true), '')::uuid);
+GRANT SELECT, INSERT ON app.salesforce_billing_settings TO lf_app;
