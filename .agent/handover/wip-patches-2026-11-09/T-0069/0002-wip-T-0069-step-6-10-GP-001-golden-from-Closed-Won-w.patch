diff --git a/packages/connectors/salesforce/src/billing/closed-won.golden.db.test.ts b/packages/connectors/salesforce/src/billing/closed-won.golden.db.test.ts
new file mode 100644
index 0000000..0ff9b68
--- /dev/null
+++ b/packages/connectors/salesforce/src/billing/closed-won.golden.db.test.ts
@@ -0,0 +1,254 @@
+/**
+ * SS-UC01-03 from the trigger (T-0069): an Opportunity with the GP-001 lines moving to Closed Won,
+ * auto-approve on with a $2,000 threshold, posts exactly the Approved golden GP-001 (runGolden
+ * compares every line), numbered INV-…, with one `ar.invoice.posted` notice to the Billing To
+ * contact in the transactional outbox (the SMTP send is T-0042) and one `invoice.posted`
+ * write-back event. The invoice is produced by the billing trigger, the journal by T-0040's
+ * sales-invoice code through the posting engine. Real PostgreSQL and pg-boss outbox; no org.
+ */
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import {
+  getSalesInvoice,
+  INVOICE_POSTED_TOPIC,
+  invoiceOutboxNotifier,
+  setInvoiceSettings,
+} from '@ledgerforce/ar';
+import { withTenant, type Database } from '@ledgerforce/db';
+import {
+  expectedLines,
+  goldenModeFrom,
+  parseGoldenPostings,
+  planGoldenRun,
+  repoGoldenGate,
+  runGolden,
+  type GoldenProducer,
+  type GoldenWorld,
+  type LineView,
+} from '@ledgerforce/ledger/golden';
+import { storedJournal } from '@ledgerforce/ledger/testing';
+import { createGoldenWorld, type GoldenFixture } from '@ledgerforce/ledger/testing/golden-world';
+import { ledgerOutbox } from '@ledgerforce/outbox';
+import { createOutboxHarness, type OutboxHarness } from '@ledgerforce/outbox/testing';
+import { addContact, setContactRole } from '@ledgerforce/parties';
+import {
+  createProduct,
+  loadPostingProfileTemplate,
+  auServicesSmbProfiles,
+} from '@ledgerforce/products';
+import { auTaxCodes, loadTaxCodes } from '@ledgerforce/tax';
+import { sql, type Transaction } from 'kysely';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { billingCdc1, billingId, epochDay } from '../testing/billing-events.ts';
+import { sfId } from '../testing/master-data-events.ts';
+import { applyBillingChange, billingOutbox, type BillingDeps } from './apply.ts';
+
+const POSTINGS = fileURLToPath(
+  new URL('../../../../../Docs/accounting/postings.md', import.meta.url),
+);
+const REPO = fileURLToPath(new URL('../../../../../', import.meta.url));
+const postings = parseGoldenPostings(readFileSync(POSTINGS, 'utf8')).filter(
+  (gp) => gp.id === 'GP-001',
+);
+const plan = planGoldenRun(postings, goldenModeFrom(process.env), repoGoldenGate(REPO));
+const BILLING_TO = 'accounts@acme.example';
+const ACME_SF = sfId('001', 1);
+const PS_SF = sfId('01t', 1);
+const SUB_SF = sfId('01t', 2);
+
+let g: GoldenFixture;
+let h: OutboxHarness;
+let boss: Awaited<ReturnType<OutboxHarness['startRuntime']>>;
+let world: GoldenWorld;
+let acme: string;
+let gstId: string;
+let commit = 50_000n;
+let opp = 0;
+const posted: { invoiceId: string; invoiceNo: string; entryId: string; opportunity: string }[] = [];
+
+const inTenant = <R>(fn: (trx: Transaction<Database>) => Promise<R>) =>
+  withTenant(h.app, g.fixture.tenantId, fn);
+
+const produce: GoldenProducer = async (gp, index) => {
+  const expected = expectedLines(gp, index, world);
+  const companyId = g.fixture.companyId;
+  const id = billingId('006', (opp += 1));
+  const deps: BillingDeps = {
+    outbox: billingOutbox(boss),
+    postingOutbox: ledgerOutbox(boss),
+    notifier: invoiceOutboxNotifier(boss),
+  };
+  // GP-001: INV dated 2026-11-05, terms 14 days; $1,000 services + $250 subscription ex GST.
+  const result = await inTenant(async (trx) => {
+    const lines = [
+      { product: PS_SF, total: 1000, description: 'Professional services' },
+      { product: SUB_SF, total: 250, description: 'Subscription' },
+    ];
+    for (const [i, l] of lines.entries()) {
+      await applyBillingChange(
+        trx,
+        companyId,
+        billingCdc1({
+          entity: 'OpportunityLineItem',
+          recordIds: [billingId('00k', opp * 10 + i)],
+          changeType: 'CREATE',
+          commitNumber: (commit += 1n),
+          fields: {
+            OpportunityId: id,
+            Product2Id: l.product,
+            Description: l.description,
+            Quantity: 1,
+            UnitPrice: l.total,
+            TotalPrice: l.total,
+            SortOrder: i + 1,
+          },
+        }),
+        deps,
+      );
+    }
+    const r = await applyBillingChange(
+      trx,
+      companyId,
+      billingCdc1({
+        entity: 'Opportunity',
+        recordIds: [id],
+        changeType: 'CREATE',
+        commitNumber: (commit += 1n),
+        fields: {
+          Name: 'Acme — implementation',
+          AccountId: ACME_SF,
+          StageName: 'Closed Won',
+          IsClosed: true,
+          IsWon: true,
+          CloseDate: epochDay('2026-11-05'),
+          Amount: 1250,
+          CurrencyIsoCode: 'AUD',
+        },
+      }),
+      deps,
+    );
+    if (r.source?.status !== 'drafted' || r.source.auto.outcome !== 'posted') {
+      throw new Error(`Closed Won did not auto-post: ${JSON.stringify(r.source)}`);
+    }
+    const doc = await getSalesInvoice(trx, r.source.invoiceId);
+    return {
+      invoiceId: doc.id,
+      invoiceNo: doc.invoiceNo ?? '',
+      entryId: r.source.auto.entryId,
+      journal: await storedJournal(trx, r.source.auto.entryId),
+      dueDate: doc.dueDate,
+    };
+  });
+  expect(result.dueDate).toBe('2026-11-19');
+  posted.push({ ...result, opportunity: id });
+  const actual: LineView[] = result.journal.lines.map((l) => ({
+    lineNo: l.lineNo,
+    accountId: l.accountId,
+    accountLabel: l.accountId,
+    debit: l.debit,
+    credit: l.credit,
+    taxCodeId: l.taxCodeId,
+    taxLabel: l.taxCodeId === gstId ? 'GST' : l.taxCodeId,
+    taxAmount: l.taxAmount,
+    partyId: l.partyId,
+    partyLabel: l.partyId === null ? null : world.partyLabel(l.partyId),
+  }));
+  return { expected, actual };
+};
+
+beforeAll(async () => {
+  g = await createGoldenWorld('01900000-0000-7000-8000-000000006903');
+  h = await createOutboxHarness(g.fixture.tdb);
+  boss = await h.startRuntime();
+  const companyId = g.fixture.companyId;
+  const party = g.world.partyId('Acme');
+  if (party === undefined) throw new Error('golden world has no Acme');
+  acme = party;
+  const financeAdmin = await g.fixture.addUser('finance_admin');
+  gstId = await inTenant(async (trx) => {
+    await loadTaxCodes(trx, companyId, auTaxCodes);
+    await loadPostingProfileTemplate(trx, companyId, auServicesSmbProfiles);
+    for (const [sf, name, profile] of [
+      [PS_SF, 'Professional services', 'PROFESSIONAL_SERVICES'],
+      [SUB_SF, 'Subscription', 'SUBSCRIPTION'],
+    ] as const) {
+      const p = await createProduct(trx, { companyId, name, productPostingProfileCode: profile });
+      await sql`UPDATE app.product SET salesforce_product_id = ${sf} WHERE id = ${p.id}`.execute(
+        trx,
+      );
+    }
+    await sql`INSERT INTO app.number_series (company_id, code, prefix)
+              VALUES (${companyId}, 'ar_invoice', 'INV-') ON CONFLICT DO NOTHING`.execute(trx);
+    // Acme as the synced Salesforce customer (T-0065 sets these from the Account).
+    await sql`
+      UPDATE app.party SET salesforce_account_id = ${ACME_SF}, customer_posting_profile_id = (
+        SELECT id FROM app.party_posting_profile WHERE company_id = ${companyId} AND code = 'DOMESTIC_CUSTOMER')
+       WHERE id = ${acme}`.execute(trx);
+    await sql`INSERT INTO app.party_role (company_id, party_id, role)
+              VALUES (${companyId}, ${acme}, 'customer') ON CONFLICT DO NOTHING`.execute(trx);
+    const contact = await addContact(trx, companyId, acme, { name: 'Accounts', email: BILLING_TO });
+    await setContactRole(trx, contact, 'billing_to', true);
+    await setInvoiceSettings(trx, {
+      companyId,
+      autoApprove: true,
+      threshold: '2000',
+      setBy: financeAdmin,
+      reason: 'SS-UC01-03: auto-approve ≤ $2,000',
+    });
+    const r = await sql<{ id: string }>`
+      SELECT id::text FROM app.tax_code WHERE company_id = ${companyId} AND code = 'GST'`.execute(
+      trx,
+    );
+    return r.rows[0]?.id ?? '';
+  });
+  world = { ...g.world, taxCodeId: (code) => (code === 'GST' ? gstId : undefined) };
+});
+
+afterAll(async () => {
+  await h?.close();
+  await g?.close();
+});
+
+describe('T-0069 golden posting produced from Closed Won', () => {
+  it('GP-001 is Approved, in phase and runs (not PENDING)', () => {
+    expect(plan.map((p) => [p.gp.id, p.label, p.run])).toEqual([['GP-001', 'APPROVED', true]]);
+  });
+
+  it('SS-UC01-03: Auto-approve under threshold posts GP-001 and emails', async () => {
+    const p = plan[0];
+    if (!p) throw new Error('GP-001 missing from postings.md');
+    const outcome = await runGolden(p, produce);
+    expect(outcome.status, outcome.report).toBe('PASS');
+    const doc = posted[0];
+    if (!doc) throw new Error('Closed Won posted nothing');
+    expect(doc.invoiceNo).toMatch(/^INV-\d{6}$/);
+    const events = await g.fixture.admin.query<{ topic: string; payload: Record<string, unknown> }>(
+      `SELECT topic, payload FROM app.outbox_event
+        WHERE tenant_id = $1 AND aggregate_id = $2 ORDER BY created_at, id`,
+      [g.fixture.tenantId, doc.invoiceId],
+    );
+    expect(events.rows.map((e) => e.topic).sort()).toEqual(
+      [INVOICE_POSTED_TOPIC, 'invoice.posted'].sort(),
+    );
+    const email = events.rows.find((e) => e.topic === INVOICE_POSTED_TOPIC);
+    expect(email?.payload).toMatchObject({
+      invoiceId: doc.invoiceId,
+      invoiceNo: doc.invoiceNo,
+      entryId: doc.entryId,
+      partyId: acme,
+      to: [BILLING_TO],
+      cc: [],
+      total: '1375.0000',
+    });
+    const writeBack = events.rows.find((e) => e.topic === 'invoice.posted');
+    expect(writeBack?.payload).toMatchObject({
+      source: { entity: 'Opportunity', recordId: doc.opportunity },
+      writeBack: {
+        version: 1,
+        opportunities: [
+          { sfId: doc.opportunity, invoiceStatus: 'posted', amountInvoiced: '1375.0000' },
+        ],
+      },
+    });
+  });
+});
