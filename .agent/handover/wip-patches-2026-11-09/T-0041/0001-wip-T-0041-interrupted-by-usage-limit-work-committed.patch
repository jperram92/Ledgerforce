@@ -0,0 +1,15 @@
+import { chromium } from 'playwright-core';
+import { writeFileSync } from 'node:fs';
+const out = process.argv[2] ?? 'probe.pdf';
+const b = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium' });
+const ctx = await b.newContext({ javaScriptEnabled: false });
+const p = await ctx.newPage();
+await p.route('**/*', (r) => r.abort());
+await p.setContent(
+  '<html><head><title>Tax invoice INV-000001</title><style>body{font-family:"Liberation Sans",Arial,sans-serif}</style></head><body><h1>Tax invoice</h1><p>ABN 51 824 753 556</p><table><tr><td>GST</td><td>125.00</td></tr><tr><td>Total</td><td>1,375.00</td></tr></table></body></html>',
+  { waitUntil: 'load' },
+);
+const pdf = await p.pdf({ format: 'A4', printBackground: true, tagged: true });
+writeFileSync(out, pdf);
+await b.close();
+console.log(pdf.length);
