{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NestJS needs legacy decorators + metadata (RQ-0015, DL-0061); SWC emits them, tsc only checks.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "erasableSyntaxOnly": false
  },
  "include": ["src/**/*.ts"]
}
