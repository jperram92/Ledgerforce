    "@ledgerforce/parties": "workspace:*",
    "@ledgerforce/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "kysely": "0.29.7",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@ledgerforce/gl": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
