<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>LedgerForce billing summary on an Account: balance due, overdue amount, last payment, credit status and the five most recent LedgerForce invoices (UC-12). Reads Salesforce mirror data only.</description>
    <isExposed>true</isExposed>
    <masterLabel>LedgerForce Account Summary</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
